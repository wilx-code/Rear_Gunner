-) {" line1="" line2="        let smokeAge2 =" line3="            (explosionTime - smokeIndex * 4) % 160" line4="" line5="        if (smokeAge2 &gt; 0) {" line6="" line7="            let rise = smokeAge2 * 5" line8="" line9="            let drift = rise * 0.18" line10="" line11="            let turbulence = Math.sin(" line12="                smokeAge2 * 0.09" line13="            ) * (8 + rise * 0.06)" line14="" line15="            let smokeX2 = carrierX +" line16="                drift + turbulence" line17="" line18="            let smokeY2 = carrierY - 25 - rise" line19="" line20="            let smokePoint = projectMissionPoint(" line21="                smokeX2," line22="                smokeY2," line23="                carrierZ" line24="            )" line25="" line26="            if (smokePoint.length &gt; 0) {" line27="" line28="                let sx4 = Math.round(smokePoint[0])" line29="                let sy4 = Math.round(smokePoint[1])" line30="" line31="                let smokeScale =" line32="                    focalLength / smokePoint[2]" line33="" line34="                let smokeRadius = Math.max(" line35="                    1," line36="                    Math.min(" line37="                        22," line38="                        (12 + rise * 0.09) * smokeScale" line39="                    )" line40="                )" line41="" line42="                let smokeColor = 3" line43="" line44="                if (smokeAge2 &gt; 50) {" line45="                    smokeColor = 10" line46="                }" line47="" line48="                if (smokeAge2 &gt; 110) {" line49="                    smokeColor = 12" line50="                }" line51="" line52="                terrain.fillCircle(" line53="                    sx4, sy4," line54="                    Math.max(1, Math.round(smokeRadius))," line55="                    smokeColor" line56="                )" line57="" line58="                terrain.fillCircle(" line59="                    Math.ro