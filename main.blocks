="            smokeZ.removeAt(j)" line8="            smokeAge.removeAt(j)" line9="        } else {" line10="            let rx = smokeX[j] * cyaw - smokeZ[j] * syaw" line11="            let rz = smokeX[j] * syaw + smokeZ[j] * cyaw" line12="            let ry = smokeY[j] * cpitch - rz * spitch" line13="            let depth = smokeY[j] * spitch + rz * cpitch" line14="            if (depth &gt; 100) {" line15="                let x = 120 + rx * focalLength / depth" line16="                let y = 90 + ry * focalLength / depth + tilt * (x - 120) / 120" line17="                let r = Math.max(1, Math.min(9, Math.round((18 + smokeAge[j] * 0.8) * focalLength / depth)))" line18="                let d = 3" line19="                if (smokeAge[j] &gt; 25) d = 10" line20="                if (smokeAge[j] &gt; 50) d = 12" line21="                if (x &gt; -10 &amp;&amp; x &lt; 250 &amp;&amp; y &gt; -10 &amp;&amp; y &lt; 190) {" line22="                    terrain.fillCircle(Math.round(x), Math.round(y), r, d)" line23="                }" line24="            }" line25="        }" line26="    }" numlines="27"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="Z91O]s(ZaU~?tPyi(|:?" x="7530" y="4773"><mutation name="updateEnemyFiring" functionid=":J7(rXb!09}#V.:T|Ndt"></mutation><field name="function_name">updateEnemyFiring</field><statement name="STACK"><block type="pxt_controls_for" id="k5;*[)1YVi6u9APE*pY;"><value name="VAR"><block type="variables_get_reporter" id="pft-*~isw`Z6WS$4lAM-" deletable="false"><field name="VAR" id="EK(xsAUG]euq]T*$*~Wb">k</field></block></value><value name="TO"><shadow type="math_whole_number" id=",FTQR4DZ)n6Vto{K#;?D"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="yTNC|bYZ(RTMOgOH]d03"><field name="OP">MINUS</field><value name="A"><shadow type="math_number" id="=f:k%jE|$jjYF1PR2gHe"><field name="NUM">0</field></s