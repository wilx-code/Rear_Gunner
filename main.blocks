 name="renderBullets" functionid="OtQn]i)_2sQQgQ++:.VK"></mutation><field name="function_name">renderBullets</field><statement name="STACK"><block type="typescript_statement" id="*)88z_=T3j@.g=q6L.HJ"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="for (let i = bulletDepth.length - 1; i &gt;= 0; i--) {" line1="" line2="        bulletDepth[i] += 0.18" line3="" line4="        let perspective = 1 / bulletDepth[i]" line5="" line6="        let relativeYaw =" line7="            (bulletYaw[i] - getViewYaw()) * Math.PI / 180" line8="" line9="        let relativePitch =" line10="            (getViewPitch() - bulletPitch[i]) * Math.PI / 180" line11="" line12="        if (" line13="            Math.abs(relativeYaw) &lt; 1.4 &amp;&amp;" line14="            Math.abs(relativePitch) &lt; 1.4" line15="        ) {" line16="" line17="            let bx = 120 +" line18="                Math.tan(relativeYaw) * focalLength +" line19="                bulletX[i] * perspective" line20="" line21="            let by = 90 +" line22="                Math.tan(relativePitch) * focalLength +" line23="                bulletY[i] * perspective" line24="" line25="            let trailPerspective = 1 / Math.max(" line26="                1, bulletDepth[i] - 0.5" line27="            )" line28="" line29="            let trailX = 120 +" line30="                Math.tan(relativeYaw) * focalLength +" line31="                bulletX[i] * trailPerspective" line32="" line33="            let trailY = 90 +" line34="                Math.tan(relativePitch) * focalLength +" line35="                bulletY[i] * trailPerspective" line36="" line37="            by += tilt * (bx - 120) / 120" line38="            trailY += tilt * (trailX - 120) / 120" line39="" line40="            if (" line41="                bx &gt;= 0 &amp;&amp; bx &lt; 240 &amp;&amp;" line42="                by &gt;= 0 &amp;&amp; by &lt; 180" line43="            ) {" line44="" line45="                terrain.drawLine(" line46="                    Math.round(trailX)," line47="                    Math.round(trailY)," line48="                    Math.round(bx)," line49="                    Math.round(by)," line50="                    4" line51="                )" line52="" line53="                terrain.fillRect(" line54="                    Math.round(bx)," line55="                    Math.round(by)," line56="                    2, 2, 5" line57="                )" line58="            }" line59="        }" line60="" line61="        if (bulletDepth[i] &gt; 5) {" line62="" line63="            bulletX.removeAt(i)" line64="            bulletY.removeAt(i)" line65="            bulletDepth.removeAt(i)" line66="            bulletYaw.removeAt(i)" line67="            bulletPitch.removeAt(i)" line68="        }" line69="    }" numlines="70"></mutation></block></statement></block><block type="function_definition" id="[+QW_LQ4*#hT`]6{#H/$" x="6312" y="0"><mutation name="getHorizon" functionid="0,Aa^xO{m!qFDW]l_z=A"><arg name="screenPositionX" id="vqn9c5136hl93lj8ef3tsa" type="number"></arg></mutation><field name="function_name">getHorizon</field><value name="vqn9c5136hl93lj8ef3tsa"><block type="argument_reporter_number" id="4h%riB[RV91*|I^^PGB2" deletable="false"><field name="VALUE">screenPositionX</field></block></value><statement name="STACK"><block type="function_return" id="4A~CW?D^Yq|.;U}sB.SR"><mutation xmlns="http://www.w3.org/1999/xhtml" no_return_value="false"></mutation><value name="RETURN_VALUE"><shadow type="math_number" id="J3OR.]SEQN9kMvG^diQs"><field name="NUM">0</field></shadow><block type="math_js_round" id="3CAmV0lH=Zf}0hY:wat1"><field name="OP">round</field><value name="ARG0"><shadow type="math_number" id="5@3O?F^Q4pTBRrSl@@D}"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="yQzkOTuR#YZ*eRlu}5m_"><field name="OP">ADD</field><value name="A"><shadow type="math_number" id="6+ckV^mxYw6r-x=A@)KR"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="aSx8cXmfK~$CW~%v#wjV