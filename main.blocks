yaw" line12="            let ry = smokeY[j] * cpitch - rz * spitch" line13="            let depth = smokeY[j] * spitch + rz * cpitch" line14="            if (depth &gt; 100) {" line15="                let x = 120 + rx * focalLength / depth" line16="                let y = 90 + ry * focalLength / depth + tilt * (x - 120) / 120" line17="                let r = Math.max(1, Math.min(9, Math.round((18 + smokeAge[j] * 0.8) * focalLength / depth)))" line18="                let d = 3" line19="                if (smokeAge[j] &gt; 25) d = 10" line20="                if (smokeAge[j] &gt; 50) d = 12" line21="                if (x &gt; -10 &amp;&amp; x &lt; 250 &amp;&amp; y &gt; -10 &amp;&amp; y &lt; 190) {" line22="                    terrain.fillCircle(Math.round(x), Math.round(y), r, d)" line23="                }" line24="            }" line25="        }" line26="    }" numlines="27"></mutation></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="function_definition" id="V4j*Hz]Aq~UV-=Z2que6" x="11978" y="6693"><mutation name="updateEnemyFiring" functionid=":[N2bG_KTS]~4bCcX-zu"></mutation><field name="function_name">updateEnemyFiring</field><statement name="STACK"><block type="pxt_controls_for" id="i%IAUr}!SG_3X))5r9nU"><value name="VAR"><block type="variables_get_reporter" id="+|I71O)-PRVqT~^woKFU" deletable="false"><field name="VAR" id="tA!*~(m(4u1am6k;q95T">k</field></block></value><value name="TO"><shadow type="math_whole_number" id="sB9:R|en_4g%CM.*^`kL"><field name="NUM">0</field></shadow><block type="math_arithmetic" id=".5_K.v-oIjiu}IT8r.GM"><field name="OP">MINUS</field><value name="A"><shadow type="math_number" id="o7OosUW5JUoo|i|icAhs"><field name="NUM">0</field></shadow><block type="variables_get" id="Tf7luE%k[LE6FF/rHy|8"><field name="VAR" id="?~ftwX@;k[z;.qR,.36D">enemyCount</field></block></value><value name="B"><shadow type="math_number" id="n0j]8RMwF~w^1xk4hc/x"><field name="NUM">1