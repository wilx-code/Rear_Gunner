" line13="            Math.abs(relativeYaw) &lt; 1.4 &amp;&amp;" line14="            Math.abs(relativePitch) &lt; 1.4" line15="        ) {" line16="" line17="            let bx = 120 +" line18="                Math.tan(relativeYaw) * focalLength +" line19="                bulletX[i] * perspective" line20="" line21="            let by = 90 +" line22="                Math.tan(relativePitch) * focalLength +" line23="                bulletY[i] * perspective" line24="" line25="            let trailPerspective = 1 / Math.max(" line26="                1, bulletDepth[i] - 0.5" line27="            )" line28="" line29="            let trailX = 120 +" line30="                Math.tan(relativeYaw) * focalLength +" line31="                bulletX[i] * trailPerspective" line32="" line33="            let trailY = 90 +" line34="                Math.tan(relativePitch) * focalLength +" line35="                bulletY[i] * trailPerspective" line36="" line37="            by += tilt * (bx - 120) / 120" line38="            trailY += tilt * (trailX - 120) / 120" line39="" line40="            if (" line41="                bx &gt;= 0 &amp;&amp; bx &lt; 240 &amp;&amp;" line42="                by &gt;= 0 &amp;&amp; by &lt; 180" line43="            ) {" line44="" line45="                terrain.drawLine(" line46="                    Math.round(trailX)," line47="                    Math.round(trailY)," line48="                    Math.round(bx)," line49="                    Math.round(by)," line50="                    4" line51="                )" line52="" line53="                terrain.fillRect(" line54="                    Math.round(bx)," line55="                    Math.round(by)," line56="                    2, 2, 5" line57="                )" line58="            }" line59="        }" line60="" line61="        if (bulletDepth[i] &gt; 5) {" line62="" line63="            bulletX.removeAt(i)" line64="            bulletY.removeAt(i)" line65="            bulletDepth.removeAt(i)" line66="            bulletYaw.removeAt(i)" line67="            bulletPitch.removeAt(i)" line68="        }" line69="    }" numlines="70"></mutation></block></statement></block><block type="function_definition" id="2%Y9ztB%yi[dif$r=6`g" x="6900" y="20"><mutation name="getHorizon" functionid="+(HCqJAu?xsf}u1|y{G6"><arg name="screenPositionX" id="ymfljn70coilulyatdpl" type="number"></arg></mutation><field name="function_name">getHorizon</field><value name="ymfljn70coilulyatdpl"><block type="argument_reporter_number" id="zM4#XB9I/w?n6m.5w%;W" deletable="false"><field name="VALUE">screenPositionX</field></block></value><statement name="STACK"><block type="function_return" id="CckV]NT$4]GH#VecVDap"><mutation xmlns="http://www.w3.org/1999/xhtml" no_return_value="false"></mutation><value name="RETURN_VALUE"><shadow type="math_number" id="L|6tJv|DaL%V@nIRG=7Z"><field name="NUM">0</field></shadow><block type="math_js_round" id="){?ed]sDL()MYakw8.k^"><field name="OP">round</field><value name="ARG0"><shadow type="math_number" id="JNRL8:?{86-?DK%20w48"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="ysq#].r!%FD`.Q{q{u+9"><field name="OP">ADD</field><value name="A"><shadow type="math_number" id="Hbbb+;yO:].3ut[lzWkt"><field name="NUM">0</field></shadow><block type="math_arithmetic" id=";FRw8;dWgs-G:-qjtjT5"><field name="OP">ADD</field><value name="A"><shadow type="math_number" id="a(Duh9c14.-!Kik!!*3L"><field name="NUM">90</field></shadow></value><value name="B"><shadow type="math_number" id="y4pi)4}@KwXdDItK#|[H"><field name="NUM">0</field></shadow><block type="variables_get" id="UGUVI(H]}oJIIhXli3?M"><field name="VAR" id="0gQ(s,p8z|:dpIiqbJa=">updown</field></block></value></block></value><value name="B"><shadow type="math_number" id="9K*w8eW::NIJ|0s;]%=}"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="K=oN_euioKb5.*Jp?+Zu"><field name="OP">DIVIDE</field><value name="A"><shadow type="math_number" id="C*B#ktwE[.:%^y%]o5qz"><field name="NUM">0</fiel