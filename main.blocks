ine42="                let smokeColor = 3" line43="" line44="                if (smokeAge2 &gt; 50) {" line45="                    smokeColor = 10" line46="                }" line47="" line48="                if (smokeAge2 &gt; 110) {" line49="                    smokeColor = 12" line50="                }" line51="" line52="                terrain.fillCircle(" line53="                    sx4, sy4," line54="                    Math.max(1, Math.round(smokeRadius))," line55="                    smokeColor" line56="                )" line57="" line58="                terrain.fillCircle(" line59="                    Math.round(sx4 - smokeRadius * 0.7)," line60="                    Math.round(sy4 - smokeRadius * 0.4)," line61="                    Math.max(1, Math.round(smokeRadius * 0.65))," line62="                    smokeColor" line63="                )" line64="" line65="                terrain.fillCircle(" line66="                    Math.round(sx4 + smokeRadius * 0.6)," line67="                    Math.round(sy4 + smokeRadius * 0.3)," line68="                    Math.max(1, Math.round(smokeRadius * 0.55))," line69="                    smokeColor" line70="                )" line71="            }" line72="        }" line73="    }" numlines="74"></mutation><next><block type="variables_set" id="U=l6?E|1CbgJO_5=.oUr"><field name="VAR" id="Vogz];Oo++0N#!jXU^.0">firePoint</field><value name="VALUE"><shadow type="math_number" id="1YsGr?8D,DMf$McH8;R1"><field name="NUM">0</field></shadow><block type="function_call_output" id="30[-!sj.%jvTx?%on):%"><mutation name="projectMissionPoint" functionid="#=kGUMO0@7DVFD!rK8EL"><arg name="worldX" id="v8p10zgzjicglywlicz8" type="number"></arg><arg name="worldY" id="41czzvahdc82n9q0z0q6" type="number"></arg><arg name="worldZ" id="5ylnrmgfzsk0slnzv50iu" type="number"></arg></mutation><value name="v8p10zgzjicglywlicz8"><shadow type="math_number" id="[^B)/9Y619#d+iCYIVBZ"><field name="NUM">1</field></shadow><block type="variables_get" id="=