 + rise * 0.06)" line14="" line15="            let smokeX2 = carrierX +" line16="                drift + turbulence" line17="" line18="            let smokeY2 = carrierY - 25 - rise" line19="" line20="            let smokePoint = projectMissionPoint(" line21="                smokeX2," line22="                smokeY2," line23="                carrierZ" line24="            )" line25="" line26="            if (smokePoint.length &gt; 0) {" line27="" line28="                let sx4 = Math.round(smokePoint[0])" line29="                let sy4 = Math.round(smokePoint[1])" line30="" line31="                let smokeScale =" line32="                    focalLength / smokePoint[2]" line33="" line34="                let smokeRadius = Math.max(" line35="                    1," line36="                    Math.min(" line37="                        22," line38="                        (12 + rise * 0.09) * smokeScale" line39="                    )" line40="                )" line41="" line42="                let smokeColor = 3" line43="" line44="                if (smokeAge2 &gt; 50) {" line45="                    smokeColor = 10" line46="                }" line47="" line48="                if (smokeAge2 &gt; 110) {" line49="                    smokeColor = 12" line50="                }" line51="" line52="                terrain.fillCircle(" line53="                    sx4, sy4," line54="                    Math.max(1, Math.round(smokeRadius))," line55="                    smokeColor" line56="                )" line57="" line58="                terrain.fillCircle(" line59="                    Math.round(sx4 - smokeRadius * 0.7)," line60="                    Math.round(sy4 - smokeRadius * 0.4)," line61="                    Math.max(1, Math.round(smokeRadius * 0.65))," line62="                    smokeColor" line63="                )" line64="" line65="                terrain.fillCircle(" line66="                    Math.round(sx4 + smokeRadius * 0.6)," line67="                    Math.round(sy4 + smokeRadius * 0.3)," line68="                    Math.max(1, Math.round(smokeRadius * 0.55))," line69="                    smokeColor" line70="                )" line71="            }" line72="        }" line73="    }" numlines="74"></mutation><next><block type="variables_set" id="R61Vh8Dl3-p+DPGE1iC]"><field name="VAR" id="C3vJCVFwpo}%va%FD]]x">firePoint</field><value name="VALUE"><shadow type="math_number" id="0oy.$i.rY;WF8j1ER6xR"><field name="NUM">0</field></shadow><block type="function_call_output" id="1{u[|{9W:*,OzAMPs,AL"><mutation name="projectMissionPoint" functionid="_Dc9}`VnE]16+Nmd/zQC"><arg name="worldX" id="9sii6f64x9rzy1ui5ycna" type="number"></arg><arg name="worldY" id="1g59ugt4fmxmgnq0g9qvl" type="number"></arg><arg name="worldZ" id="czu4ucz2fl8vbm8ovnqxtn" type="number"></arg></mutation><value name="9sii6f64x9rzy1ui5ycna"><shadow type="math_number" id="K?Gpen*QIeKB|DrMyDU("><field name="NUM">1</field></shadow><block type="variables_get" id="6GEAx%^cF`(6Nb~gy8?q"><field name="VAR" id="qU+iM[oI=7Iq43A;gtLA">carrierX</field></block></value><value name="1g59ugt4fmxmgnq0g9qvl"><shadow type="math_number" id="fxIKUt{DP0~FG+rocku{"><field name="NUM">1</field></shadow><block type="math_arithmetic" id="3$y[=0nH:hR5/7-7eo6("><field name="OP">MINUS</field><value name="A"><shadow type="math_number" id="1%w(m=ad0E9)#$C!+_le"><field name="NUM">0</field></shadow><block type="variables_get" id="Y;1z0:`ses)e3$l`T#Kh"><field name="VAR" id="V{%qM#.7!UFTbJd,pYKl">carrierY</field></block></value><value name="B"><shadow type="math_number" id="zINuh1Z)AsL8%CYX_1a)"><field name="NUM">30</field></shadow></value></block></value><value name="czu4ucz2fl8vbm8ovnqxtn"><shadow type="math_number" id="CqJRG^J8x-]UmpAjyn.e"><field name="NUM">1</field></shadow><block type="variables_get" id="*1zzpR.}$j)||y`E:+67"><field name="VAR" id="Ft+UTcfuzB@MVXoRc7PR">carrierZ</field></block></value></block></value><next><block type="controls_if" id="3_W,?1?T6+Xh6V]VW4,m"><value 