wPitch() - bulletPitch[i]) * Math.PI / 180" line11="" line12="        if (" line13="            Math.abs(relativeYaw) &lt; 1.4 &amp;&amp;" line14="            Math.abs(relativePitch) &lt; 1.4" line15="        ) {" line16="" line17="            let bx = 120 +" line18="                Math.tan(relativeYaw) * focalLength +" line19="                bulletX[i] * perspective" line20="" line21="            let by = 90 +" line22="                Math.tan(relativePitch) * focalLength +" line23="                bulletY[i] * perspective" line24="" line25="            let trailPerspective = 1 / Math.max(" line26="                1, bulletDepth[i] - 0.5" line27="            )" line28="" line29="            let trailX = 120 +" line30="                Math.tan(relativeYaw) * focalLength +" line31="                bulletX[i] * trailPerspective" line32="" line33="            let trailY = 90 +" line34="                Math.tan(relativePitch) * focalLength +" line35="                bulletY[i] * trailPerspective" line36="" line37="            by += tilt * (bx - 120) / 120" line38="            trailY += tilt * (trailX - 120) / 120" line39="" line40="            if (" line41="                bx &gt;= 0 &amp;&amp; bx &lt; 240 &amp;&amp;" line42="                by &gt;= 0 &amp;&amp; by &lt; 180" line43="            ) {" line44="" line45="                terrain.drawLine(" line46="                    Math.round(trailX)," line47="                    Math.round(trailY)," line48="                    Math.round(bx)," line49="                    Math.round(by)," line50="                    4" line51="                )" line52="" line53="                terrain.fillRect(" line54="                    Math.round(bx)," line55="                    Math.round(by)," line56="                    2, 2, 5" line57="                )" line58="            }" line59="        }" line60="" line61="        if (bulletDepth[i] &gt; 5) {" line62="" line63="            bulletX.removeAt(i)" line64="            bulle