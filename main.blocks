1999/xhtml" line0="for (let smokeIndex = 39; smokeIndex &gt;= 0; smokeIndex--) {" line1="" line2="        let smokeAge2 =" line3="            (explosionTime - smokeIndex * 4) % 160" line4="" line5="        if (smokeAge2 &gt; 0) {" line6="" line7="            let rise = smokeAge2 * 5" line8="" line9="            let drift = rise * 0.18" line10="" line11="            let turbulence = Math.sin(" line12="                smokeAge2 * 0.09" line13="            ) * (8 + rise * 0.06)" line14="" line15="            let smokeX2 = carrierX +" line16="                drift + turbulence" line17="" line18="            let smokeY2 = carrierY - 25 - rise" line19="" line20="            let smokePoint = projectMissionPoint(" line21="                smokeX2," line22="                smokeY2," line23="                carrierZ" line24="            )" line25="" line26="            if (smokePoint.length &gt; 0) {" line27="" line28="                let sx4 = Math.round(smokePoint[0])" line29="                let sy4 = Math.round(smokePoint[1])" line30="" line31="                let smokeScale =" line32="                    focalLength / smokePoint[2]" line33="" line34="                let smokeRadius = Math.max(" line35="                    1," line36="                    Math.min(" line37="                        22," line38="                        (12 + rise * 0.09) * smokeScale" line39="                    )" line40="                )" line41="" line42="                let smokeColor = 3" line43="" line44="                if (smokeAge2 &gt; 50) {" line45="                    smokeColor = 10" line46="                }" line47="" line48="                if (smokeAge2 &gt; 110) {" line49="                    smokeColor = 12" line50="                }" line51="" line52="                terrain.fillCircle(" line53="                    sx4, sy4," line54="                    Math.max(1, Math.round(smokeRadius))," line55="                    smokeColor" line56="                )" line57="" line58="                terrain.fillCircle(" line59="                    Math.round(sx4 - smokeRadius * 0.7)," line60="                    Math.round(sy4 - smokeRadius * 0.4)," line61="                    Math.max(1, Math.round(smokeRadius * 0.65))," line62="                    smokeColor" line63="                )" line64="" line65="                terrain.fillCircle(" line66="                    Math.round(sx4 + smokeRadius * 0.6)," line67="                    Math.round(sy4 + smokeRadius * 0.3)," line68="                    Math.max(1, Math.round(smokeRadius * 0.55))," line69="                    smokeColor" line70="                )" line71="            }" line72="        }" line73="    }" numlines="74"></mutation><next><block type="variables_set" id="Z)ROz?%2#;r)rOF[I|K#"><field name="VAR" id="d5U?-GEl8-mYb!4E:@{e">firePoint</field><value name="VALUE"><shadow type="math_number" id="BR-72E@sxxhlWan6[5Bo"><field name="NUM">0</field></shadow><block type="function_call_output" id="@Ti}_2yae_!i{xB``QJI"><mutation name="projectMissionPoint" functionid="9g,zw}|;~S5v8H7YtqD7"><arg name="worldX" id="2ejvxrk79geubu14ar4fu9" type="number"></arg><arg name="worldY" id="zned718z8o8qye4gybte2" type="number"></arg><arg name="worldZ" id="blmenol8epnl9al0td2j" type="number"></arg></mutation><value name="2ejvxrk79geubu14ar4fu9"><shadow type="math_number" id="qx6RCDJj]{WZ3HW~mb(V"><field name="NUM">1</field></shadow><block type="variables_get" id="-8aGfsbZHG5`N#QaPN+k"><field name="VAR" id="|3g#7DU;P=^jAzsljVgn">carrierX</field></block></value><value name="zned718z8o8qye4gybte2"><shadow type="math_number" id="@-@bi@%Unl4H4;[#6?RH"><field name="NUM">1</field></shadow><block type="math_arithmetic" id="Y.B1Ek{tO}fQ.wskJUY`"><field name="OP">MINUS</field><value name="A"><shadow type="math_number" id="|UA$!iOyCodRvz2c#8?Q"><field name="NUM">0</field></shadow><block type="variables_get" id="q(b#@pwBzAY(-cL^_r=o"><field name="VAR" id="9eWyF6Z;_nn[cDC}hM.v">carrierY</field></block></value><va