"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"!1`EXT2{,DmJ/s51,gF:\">cloudScreenY</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">-50</field></shadow></value></block></value></block></value><value name=\"B\"><shadow type=\"logic_boolean\"><field name=\"BOOL\">TRUE</field></shadow><block type=\"logic_compare\"><field name=\"OP\">LT</field><value name=\"A\"><shadow type=\"math_number\"><field name=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"!1`EXT2{,DmJ/s51,gF:\">cloudScreenY</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">230</field></shadow></value></block></value></block></value><statement name=\"DO0\"><block type=\"function_call\"><mutation name=\"drawScaledCloud\" functionid=\"gy=Q((?-Ia0i`*$Fp3zZ\"><arg name=\"targetX\" id=\"udlqkw09voflmvx04bdv\" type=\"number\"></arg><arg name=\"targetY\" id=\"ypybvlm0xcaekd73gg6k\" type=\"number\"></arg><arg name=\"cloudScale\" id=\"emku2x16gc7j0sgqghhxk\" type=\"number\"></arg></mutation><value name=\"udlqkw09voflmvx04bdv\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"f^!Lld;%%Rx2-A(iO9)C\">cloudScreenX</field></block></value><value name=\"ypybvlm0xcaekd73gg6k\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"!1`EXT2{,DmJ/s51,gF:\">cloudScreenY</field></block></value><value name=\"emku2x16gc7j0sgqghhxk\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"Nc{o#vx4xL8jUOIsd50T\">cloudScale</field></block></value></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>","main.ts":"let firing = false\nlet gunRecoil = 0\nlet muzzleFlash = 0\nlet fireTimer = 0\nlet fireInterval = 100\n\nlet bulletX: number[] = []\nlet bulletY: number[] = []\nlet bulletDepth: number[] = []\nnamespace SpriteKind {\n    export const UI = SpriteKind.create()\n}\n// ========================================\nfunction getHorizon (screenPositionX: number) {\n    return Math.round(90 + updown + tilt * (screenPositionX - 120) / 120)\n}\nfunction fillQuad (x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, x4: number, y4: number, col: number) {\n    fillTriangle(x1, y1, x2, y2, x3, y3, col)\n    fillTriangle(x1, y1, x3, y3, x4, y4, col)\n}\nfunction renderSight () {\n    sightX = Math.round(120 + gunSwayX)\n    let sightY = Math.round(90 + gunSwayY)\n    terrain.drawCircle(sightX, sightY, 10, 3)\nterrain.drawCircle(sightX, sightY, 3, 3)\nterrain.drawLine(sightX - 15, sightY, sightX - 6, sightY, 3)\n    terrain.drawLine(sightX + 6, sightY, sightX + 15, sightY, 3)\n    terrain.drawLine(sightX, sightY - 15, sightX, sightY - 6, 3)\n    terrain.drawLine(sightX, sightY + 6, sightX, sightY + 15, 3)\n}\nfunction drawScaledCloud (targetX: number, targetY: number, cloudScale: number) {\n    cloudWidth = Math.max(1, Math.round(cloudImage.width * cloudScale))\n    cloudHeight = Math.max(1, Math.round(cloudImage.height * cloudScale))\n    for (let px = 0; px <= cloudWidth - 1; px++) {\n        for (let py = 0; py <= cloudHeight - 1; py++) {\n            sourceX = Math.floor(px * cloudImage.width / cloudWidth)\n            sourceY = Math.floor(py * cloudImage.height / cloudHeight)\n            pixelColor = cloudImage.getPixel(sourceX, sourceY)\n            pixelX = Math.round(targetX + px - cloudWidth / 2)\n            pixelY = Math.round(targetY + py - cloudHeight / 2)\n            localHorizon = getHorizon(pixelX)\n            // Only draw visible cloud pixels above the ocean\n            if (pixelColor != 0 && pixelX >= 0 && pixelX < 240 && pixelY >= 0 && pixelY < 180 && pixelY < localHorizon) {\n                terrain.setPixel(pixelX, pixelY, pixelColor)\n            }\n        }\n    }\n}\nbrowserEvents.R.onEvent(browserEvents.KeyEvent.Pressed, function () {\n    cameraYaw = 0\n    cameraPitch = 0\n    cameraVelocityX = 0\n    cameraVelocityY = 0\n    mouseDeltaX = 0\n    mouseDeltaY = 0\n})\n\nfunction renderGuns() {\n\n    // Smooth gun sway\n    gunSwayX += (\n        -cameraVelocityX * 2 - gunSwayX\n    ) * gunWeight\n\n    gunSwayY += (\n        -cameraVelocityY * 2 - gunSwayY\n    ) * gunWeight\n\n    let gx = gunSwayX\n    let gy = gunSwayY+gunRecoil\n\n    // CENTRAL MOUNT\n    fillQuad(\n        85 + gx, 200 + gy,\n        105 + gx, 146 + gy,\n        135 + gx, 146 + gy,\n        155 + gx, 200 + gy,\n        10\n    )\n\n    // DRAW BOTH GUNS\n    for (let gunIndex = 0; gunIndex < 2; gunIndex++) {\n\n        let side = gunIndex * 2 - 1\n\n        // Perspective coordinates\n        let rearX = 120 + side * 55 + gx\n        let middleX = 120 + side * 30 + gx\n        let frontX = 120 + side * 9 + gx\n\n        // BARREL\n        fillQuad(\n            middleX - 5, 143 + gy,\n            frontX - 2, 98 + gy,\n            frontX + 2, 98 + gy,\n            middleX + 5, 143 + gy,\n            10\n        )\n\n        // BARREL HIGHLIGHT\n        terrain.drawLine(\n            Math.round(middleX - 3),\n            Math.round(143 + gy),\n            Math.round(frontX - 1),\n            Math.round(98 + gy),\n            11\n        )\n\n        // BARREL TIP\n        terrain.fillRect(\n            Math.round(frontX - 2),\n            Math.round(96 + gy),\n            4, 4, 3\n        )\n\n        // MAIN RECEIVER\n        fillQuad(\n            rearX - 13, 200 + gy,\n            middleX - 6, 137 + gy,\n            middleX + 6, 137 + gy,\n            rearX + 13, 200 + gy,\n            3\n        )\n\n        // UPPER RECEIVER SURFACE\n        fillQuad(\n            rearX - 9, 200 + gy,\n            middleX - 4, 139 + gy,\n            middleX + 3, 139 + gy,\n            rearX + 5, 200 + gy,\n            10\n        )\n\n        // RECEIVER HIGHLIGHT\n        terrain.drawLine(\n            Math.round(rearX - 8),\n            Math.round(200 + gy),\n            Math.round(middleX - 3),\n            Math.round(139 + gy),\n            11\n        )\n    }\n\n    // CONNECTING SUPPORT\n    fillQuad(\n        83 + gx, 169 + gy,\n        157 + gx, 169 + gy,\n        162 + gx, 178 + gy,\n        78 + gx, 178 + gy,\n        12\n    )\n}\n\nbrowserEvents.onMouseMove(function (x, y) {\n    mouseX = x\n    mouseY = y\n    if (mouseInitialized) {\n        mouseDeltaX += x - previousMouseX\n        mouseDeltaY += previousMouseY - y\n    }\n    previousMouseX = x\n    previousMouseY = y\n    mouseInitialized = true\n})\nfunction fillTriangle (x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, col: number) {\n    steps = Math.ceil(Math.max(1, Math.max(Math.abs(x3 - x2), Math.abs(y3 - y2))))\n    for (let step = 0; step <= steps; step++) {\n        fraction = step / steps\n        endX = x2 + (x3 - x2) * fraction\n        endY = y2 + (y3 - y2) * fraction\n        terrain.drawLine(Math.round(x1), Math.round(y1), Math.round(endX), Math.round(endY), col)\n    }\n}\nfunction renderClouds () {\n    yawRadians = cameraYaw * Math.PI / 180\n    pitchRadians = (0 - cameraPitch) * Math.PI / 180\n    // Calculate trigonometric values once\n    cosYaw = Math.cos(yawRadians)\n    sinYaw = Math.sin(yawRadians)\n    cosPitch = Math.cos(pitchRadians)\n    sinPitch = Math.sin(pitchRadians)\n    for (let cloudIndex2 = 0; cloudIndex2 <= cloudCount - 1; cloudIndex2++) {\n        cloudZ[cloudIndex2] += speed / 200 * cloudTravelSpeed\n// Recycle distant clouds\n        if (cloudZ[cloudIndex2] > 2200) {\n            cloudZ[cloudIndex2] = -2200\n            cloudX[cloudIndex2] = randint(-2000, 2000)\n            cloudY[cloudIndex2] = randint(-450, -120)\n            cloudSize[cloudIndex2] = randint(80, 220)\n        }\n        // Horizontal camera rotation\n        rotatedX = cloudX[cloudIndex2] * cosYaw - cloudZ[cloudIndex2] * sinYaw\n        rotatedZ = cloudX[cloudIndex2] * sinYaw + cloudZ[cloudIndex2] * cosYaw\n        // Vertical camera rotation\n        rotatedY = cloudY[cloudIndex2] * cosPitch - rotatedZ * sinPitch\n        cloudDepth = cloudY[cloudIndex2] * sinPitch + rotatedZ * cosPitch\n        // Only render clouds in front of the camera\n        if (cloudDepth > 100) {\n            projectedX = rotatedX * focalLength / cloudDepth\n            projectedY = rotatedY * focalLength / cloudDepth\n            cloudScreenX = 120 + projectedX\n            cloudScreenY = 90 + projectedY\n            // Aircraft banking\n            cloudScreenY += tilt * projectedX / 120\n            // Perspective scaling\n            cloudScale = cloudSize[cloudIndex2] / cloudDepth * 3\n            cloudScale = Math.min(3, cloudScale)\n            // Only draw clouds near the screen\n            if (cloudScreenX > -100 && cloudScreenX < 340 && cloudScreenY > -50 && cloudScreenY < 230) {\n                drawScaledCloud(cloudScreenX, cloudScreenY, cloudScale)\n            }\n        }\n    }\n}\nfunction renderAircraftBody () {\n    tailOffsetX = (0 - cameraYaw) * tailMovementX\n    tailOffsetY = cameraPitch * tailMovementY\n    ox = tailOffsetX\n    oy = tailOffsetY\n    // EXTENDED FUSELAGE\n    fillQuad(70 + ox, 180 + oy, 170 + ox, 180 + oy, 235 + ox, 280 + oy, 5 + ox, 280 + oy, 6)\n    // LEFT SIDE HIGHLIGHT\n    fillQuad(70 + ox, 180 + oy, 91 + ox, 180 + oy, 48 + ox, 280 + oy, 5 + ox, 280 + oy, 11)\n    // RIGHT SIDE SHADOW\n    fillQuad(149 + ox, 180 + oy, 170 + ox, 180 + oy, 235 + ox, 280 + oy, 192 + ox, 280 + oy, 10)\n    // COCKPIT OPENING\n    fillQuad(91 + ox, 187 + oy, 149 + ox, 187 + oy, 187 + ox, 280 + oy, 53 + ox, 280 + oy, 3)\n    // INTERIOR FLOOR\n    fillQuad(104 + ox, 194 + oy, 136 + ox, 194 + oy, 152 + ox, 239 + oy, 88 + ox, 239 + oy, 10)\n    // LEFT COCKPIT RIM\n    terrain.drawLine(91 + ox, 187 + oy, 53 + ox, 280 + oy, 11)\n    // RIGHT COCKPIT RIM\n    terrain.drawLine(149 + ox, 187 + oy, 187 + ox, 280 + oy, 11)\n    // SEAT\n    fillQuad(100 + ox, 247 + oy, 140 + ox, 247 + oy, 146 + ox, 280 + oy, 94 + ox, 280 + oy, 12)\n    // COCKPIT RIVETS\n    for (let rivet = 0; rivet <= 5; rivet++) {\n        terrain.setPixel(Math.round(77 - rivet * 5 + ox), Math.round(188 + rivet * 13 + oy), 3)\n        terrain.setPixel(Math.round(163 + rivet * 5 + ox), Math.round(188 + rivet * 13 + oy), 3)\n    }\n    // LEFT HORIZONTAL STABILIZER\n    fillQuad(117 + ox, 117 + oy, 92 + ox, 102 + oy, 47 + ox, 106 + oy, 40 + ox, 114 + oy, 6)\n    fillTriangle(40 + ox, 114 + oy, 117 + ox, 117 + oy, 117 + ox, 128 + oy, 10)\n    // RIGHT HORIZONTAL STABILIZER\n    fillQuad(123 + ox, 117 + oy, 148 + ox, 102 + oy, 193 + ox, 106 + oy, 200 + ox, 114 + oy, 6)\n    fillTriangle(200 + ox, 114 + oy, 123 + ox, 117 + oy, 123 + ox, 128 + oy, 10)\n    // MAIN FUSELAGE\n    fillQuad(70 + ox, 180 + oy, 114 + ox, 111 + oy, 126 + ox, 111 + oy, 170 + ox, 180 + oy, 6)\n    // FUSELAGE HIGHLIGHT\n    fillQuad(70 + ox, 180 + oy, 114 + ox, 111 + oy, 118 + ox, 111 + oy, 105 + ox, 180 + oy, 11)\n    // FUSELAGE SHADOW\n    fillQuad(126 + ox, 111 + oy, 170 + ox, 180 + oy, 140 + ox, 180 + oy, 124 + ox, 111 + oy, 10)\n    // VERTICAL STABILIZER\n    fillQuad(114 + ox, 116 + oy, 115 + ox, 79 + oy, 120 + ox, 55 + oy, 130 + ox, 116 + oy, 6)\n    // RUDDER\n    fillQuad(120 + ox, 55 + oy, 126 + ox, 55 + oy, 131 + ox, 65 + oy, 130 + ox, 116 + oy, 10)\n    // RUDDER HINGE\n    terrain.drawLine(124 + ox, 64 + oy, 124 + ox, 112 + oy, 3)\n    // PANEL LINES\n    terrain.drawLine(91 + ox, 150 + oy, 149 + ox, 150 + oy, 3)\n    terrain.drawLine(80 + ox, 168 + oy, 160 + ox, 168 + oy, 3)\n    // RIVETS\n    for (let rivet2 = 0; rivet2 <= 6; rivet2++) {\n        terrain.setPixel(Math.round(95 + rivet2 * 8 + ox), Math.round(153 + oy), 3)\n    }\n}\nlet waveWidth = 0\nlet waveY = 0\nlet waveDistance = 0\nlet waveDepth = 0\nlet waveX = 0\nlet travel = 0\nlet y = 0\nlet horizon = 0\nlet edgeY = 0\nlet edgeX = 0\nlet oy = 0\nlet ox = 0\nlet tailOffsetY = 0\nlet tailOffsetX = 0\nlet cloudScale = 0\nlet cloudScreenY = 0\nlet cloudScreenX = 0\nlet projectedY = 0\nlet projectedX = 0\nlet cloudDepth = 0\nlet rotatedY = 0\nlet rotatedZ = 0\nlet rotatedX = 0\nlet sinPitch = 0\nlet cosPitch = 0\nlet sinYaw = 0\nlet cosYaw = 0\nlet pitchRadians = 0\nlet yawRadians = 0\nlet endY = 0\nlet endX = 0\nlet fraction = 0\nlet steps = 0\nlet mouseInitialized = false\nlet gunX = 0\nlet gy = 0\nlet gx = 0\nlet mouseDeltaY = 0\nlet mouseDeltaX = 0\nlet cameraPitch = 0\nlet cameraYaw = 0\nlet localHorizon = 0\nlet pixelY = 0\nlet pixelX = 0\nlet pixelColor = 0\nlet sourceY = 0\nlet sourceX = 0\nlet cloudHeight = 0\nlet cloudWidth = 0\nlet gunSwayY = 0\nlet sightY = 0\nlet gunSwayX = 0\nlet sightX = 0\nlet tilt = 0\nlet updown = 0\nlet cloudSize: number[] = []\nlet cloudY: number[] = []\nlet cloudX: number[] = []\nlet spawnDistance = 0\nlet spawnAngle = 0\nlet cloudCount = 0\nlet previousMouseY = 0\nlet previousMouseX = 0\nlet focalLength = 0\nlet mouseY = 0\nlet mouseX = 0\nlet tailMovementY = 0\nlet tailMovementX = 0\nlet gunWeight = 0\nlet cloudImage: Image = null\nlet cloudZ: number[] = []\nlet cameraVelocityY = 0\nlet cameraVelocityX = 0\nlet terrain: Image = null\ngunWeight = 0.15\ntailMovementX = 2.6\ntailMovementY = 2.3\nnamespace userconfig {\n    export const ARCADE_SCREEN_WIDTH = 240\n    export const ARCADE_SCREEN_HEIGHT = 180\n}\nmouseX = 120\nmouseY = 90\nlet edgeMargin = 30\nlet edgeTurnSpeed = 1.2\nlet speed = 200\nfocalLength = 120\npreviousMouseX = 120\npreviousMouseY = 90\nlet mouseSensitivity = 0.15\nlet cameraFriction = 0.6\nlet mouseAcceleration = 0.008\ncloudCount = 80\nlet cloudTravelSpeed = 1.5\nterrain = image.create(240, 180)\nscene.setBackgroundImage(terrain)\ncloudImage = img`\n    ................................\n    .............11111..............\n    ...........111111111............\n    ......1111111111111111..........\n    ....111111111111111111111.......\n    ...111111111111111111111111.....\n    .1111111111111111111111111111...\n    111111111111111111111111111111..\n    1111111111111111111111111111111.\n    .11111111111111111111111111111..\n    ..dddd11111111dddd111111dddd....\n    ....dddddddddddddddddddddd......\n    ................................\n    `\nfor (let index = 0; index < cloudCount; index++) {\n    spawnAngle = randint(0, 359) * Math.PI / 180\n    spawnDistance = randint(200, 2000)\n    cloudX.push(Math.sin(spawnAngle) * spawnDistance)\n    cloudZ.push(Math.cos(spawnAngle) * spawnDistance)\n    cloudY.push(randint(-450, -120))\n    cloudSize.push(randint(80, 220))\n}\n// Automatic edge rotation\ngame.onUpdate(function () {\n    // Normal mouse acceleration\n    cameraVelocityX += mouseDeltaX * (mouseSensitivity + Math.abs(mouseDeltaX) * mouseAcceleration)\n    cameraVelocityY += mouseDeltaY * (mouseSensitivity + Math.abs(mouseDeltaY) * mouseAcceleration)\n    // Limit camera velocity\n    cameraVelocityX = Math.max(-6, Math.min(6, cameraVelocityX))\n    cameraVelocityY = Math.max(-6, Math.min(6, cameraVelocityY))\n    if (mouseInitialized) {\n        // Left edge\n        if (mouseX < edgeMargin) {\n            edgeX = (0 - (edgeMargin - mouseX)) / edgeMargin\n        }\n        // Right edge\n        if (mouseX > 240 - edgeMargin) {\n            edgeX = (mouseX - (240 - edgeMargin)) / edgeMargin\n        }\n        // Top edge\n        if (mouseY < edgeMargin) {\n            edgeY = (edgeMargin - mouseY) / edgeMargin\n        }\n        // Bottom edge\n        if (mouseY > 180 - edgeMargin) {\n            edgeY = (0 - (mouseY - (180 - edgeMargin))) / edgeMargin\n        }\n    }\n    // Limit edge input\n    edgeX = Math.max(-1, Math.min(1, edgeX))\n    edgeY = Math.max(-1, Math.min(1, edgeY))\n    // Smooth edge acceleration\n    edgeX = edgeX * Math.abs(edgeX)\n    edgeY = edgeY * Math.abs(edgeY)\n    // Update camera orientation\n    cameraYaw += cameraVelocityX + edgeX * edgeTurnSpeed\n    cameraPitch += cameraVelocityY + edgeY * edgeTurnSpeed\n    // Camera rotation limits\n    cameraYaw = Math.max(-80, Math.min(80, cameraYaw))\n    cameraPitch = Math.max(-45, Math.min(45, cameraPitch))\n    cameraVelocityX *= cameraFriction\ncameraVelocityY *= cameraFriction\n// Clear mouse movement\n    mouseDeltaX = 0\n    mouseDeltaY = 0\n    // Update horizon\n    updown = focalLength * Math.tan(cameraPitch * Math.PI / 180)\n})\ngame.onUpdateInterval(33, function () {\n    // Draw sky\n    terrain.fill(9)\n    // Draw ocean\n    for (let x = 0; x <= 239; x++) {\n        horizon = getHorizon(x)\n        if (horizon < 180) {\n            terrain.drawLine(x, Math.max(0, horizon), x, 179, 8)\n        }\n        // Dithered atmospheric gradient\n        for (let d = 0; d <= 23; d++) {\n            y = horizon + d\n            if (y >= 0 && y < 180) {\n                if (d < 5) {\n                    if ((x + d) % 2 == 0) {\n                        terrain.setPixel(x, y, 9)\n                    }\n                } else if (d < 13) {\n                    if (x % 2 == 0 && d % 2 == 0) {\n                        terrain.setPixel(x, y, 9)\n                    }\n                } else {\n                    if (x % 4 == 0 && d % 4 == 0) {\n                        terrain.setPixel(x, y, 9)\n                    }\n                }\n            }\n        }\n    }\n    // Ocean movement\n    travel += speed / 200\n    travel = travel % 100\n    // Moving ocean waves\n    for (let waveIndex = 0; waveIndex <= 79; waveIndex++) {\n        waveX = (waveIndex * 73 + 31 - cameraYaw * 2 + 480) % 240\n        waveDepth = (waveIndex * 37 + 100 - travel) % 100 / 100\n        waveDistance = 180 * waveDepth * waveDepth\n        waveY = getHorizon(waveX) + waveDistance\n        if (waveDistance > 24) {\n            waveWidth = 1 + waveDepth * waveDepth * 12\n            terrain.drawLine(Math.round(waveX), Math.round(waveY), Math.round(waveX + waveWidth), Math.round(waveY + tilt * waveWidth / 120), 6)\n        }\n    }\n    // Draw clouds\n    renderClouds()\n    renderAircraftBody()\n\n    updateFiring()\n    renderBullets()\n    renderGuns()\n    renderMuzzleFlash()\n    renderSight()\n    terrain.print(\n        \"Bullets: \" + bulletDepth.length,\n        5, 5, 1\n    )\n})\nforever(function () {\n    if (browserEvents.MouseLeft.isPressed()) {\n        firing = true\n    } else {\n        firing = false\n    }\n    pause(10)\n})\nfunction fireGuns() {\n\n    // Left visual tracer\n    bulletX.push(-9)\n    bulletY.push(8)\n    bulletDepth.push(1)\n\n    // Right visual tracer\n    bulletX.push(9)\n    bulletY.push(8)\n    bulletDepth.push(1)\n\n    // Visual effects\n    gunRecoil = 4\n    muzzleFlash = 2\n}\nfunction updateFiring() {\n\n    fireTimer += 33\n\n    if (firing && fireTimer >= fireInterval) {\n        fireGuns()\n        fireTimer = 0\n    }\n\n    gunRecoil *= 0.65\n}\nfunction renderBullets() {\n\n    for (let i = bulletDepth.length - 1; i >= 0; i--) {\n\n        bulletDepth[i] += 0.12\n\n        let perspective = 1 / bulletDepth[i]\n\n        let bx = 120 + bulletX[i] * perspective\n        let by = 90 + bulletY[i] * perspective\n\n        let endX = 120 + bulletX[i] * (perspective + 0.15)\n        let endY = 90 + bulletY[i] * (perspective + 0.15)\n\n        // Bright tracer\n        terrain.drawLine(\n            Math.round(bx),\n            Math.round(by),\n            Math.round(endX),\n            Math.round(endY),\n            5\n        )\n\n        // Visible white core\n        terrain.fillRect(\n            Math.round(bx),\n            Math.round(by),\n            2, 2, 1\n        )\n\n        // Remove distant tracers\n        if (bulletDepth[i] > 8) {\n            bulletX.removeAt(i)\n            bulletY.removeAt(i)\n            bulletDepth.removeAt(i)\n        }\n    }\n}\nfunction renderMuzzleFlash() {\n\n    if (muzzleFlash > 0) {\n\n        for (let gunIndex = 0; gunIndex < 2; gunIndex++) {\n\n            let side = gunIndex * 2 - 1\n\n            let fx = 120 + side * 9 + gunSwayX\n            let fy = 98 + gunSwayY + gunRecoil\n\n            // Orange outer flash\n            fillTriangle(\n                fx - 7, fy,\n                fx + 7, fy,\n                fx, fy - randint(9, 16),\n                4\n            )\n\n            // Yellow inner flash\n            fillTriangle(\n                fx - 4, fy,\n                fx + 4, fy,\n                fx, fy - 9,\n                5\n            )\n\n            // White center\n            fillTriangle(\n                fx - 2, fy,\n                fx + 2, fy,\n                fx, fy - 5,\n                1\n            )\n        }\n\n        muzzleFlash -= 1\n    }\n}","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"rear gunner prototype\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\",\n        \"browser-events\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"palette\": [\n        \"#000000\",\n        \"#FFFFFF\",\n        \"#FF2121\",\n        \"#29343F\",\n        \"#FF8135\",\n        \"#FFF609\",\n        \"#556F73\",\n        \"#78DC52\",\n        \"#003FAD\",\n        \"#87F2FF\",\n        \"#3E4141\",\n        \"#918D90\",\n        \"#655F67\",\n        \"#E5CDC4\",\n        \"#91463d\",\n        \"#000000\"\n    ]\n}\n"}},{"timestamp":1795652231410,"editorVersion":"4.1.32","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><variables><variable type=\"KIND_SpriteKind\" id=\"X.~YgS9Tk!$UY9hyf)~(\">UI</variable><variable type