ame=\"NUM\">0</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"!1`EXT2{,DmJ/s51,gF:\">cloudScreenY</field></block></value><value name=\"B\"><shadow type=\"math_number\"><field name=\"NUM\">230</field></shadow></value></block></value></block></value><statement name=\"DO0\"><block type=\"function_call\"><mutation name=\"drawScaledCloud\" functionid=\"gy=Q((?-Ia0i`*$Fp3zZ\"><arg name=\"targetX\" id=\"udlqkw09voflmvx04bdv\" type=\"number\"></arg><arg name=\"targetY\" id=\"ypybvlm0xcaekd73gg6k\" type=\"number\"></arg><arg name=\"cloudScale\" id=\"emku2x16gc7j0sgqghhxk\" type=\"number\"></arg></mutation><value name=\"udlqkw09voflmvx04bdv\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"f^!Lld;%%Rx2-A(iO9)C\">cloudScreenX</field></block></value><value name=\"ypybvlm0xcaekd73gg6k\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"!1`EXT2{,DmJ/s51,gF:\">cloudScreenY</field></block></value><value name=\"emku2x16gc7j0sgqghhxk\"><shadow type=\"math_number\"><field name=\"NUM\">1</field></shadow><block type=\"variables_get\"><field name=\"VAR\" id=\"Nc{o#vx4xL8jUOIsd50T\">cloudScale</field></block></value></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block></xml>"]]}]},{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":43668,"diffs":[[1,"// REAR GUNNER SIMULATOR\n// MakeCode Arcade + Browser Events extension\n\nnamespace userconfig {\n    export const ARCADE_SCREEN_WIDTH = 240\n    export const ARCADE_SCREEN_HEIGHT = 180\n}\n\n// AIRCRAFT AND ENVIRONMENT\nlet speed = 200\nlet tilt = 0\nlet travel = 0\nlet terrain = image.create(240, 180)\nlet aircraftLayer = image.create(240, 180)\n// ========================================\n// AI PILOT VARIABLES\n// ========================================\nlet bombReleased = false\n// BOMBING MISSION VARIABLES\n\nlet bombMessageTimer = 0\nlet bombingActive = false\nlet bombingTime = 0\nlet enemyBreakingAway: number[] = []\nlet enemyTurnTime: number[] = []\nlet enemyTurnDirection: number[] = []\n// Target carrier position\nlet carrierX = 160\nlet carrierY = 400\nlet carrierZ = -80\n\nlet explosionDelay = 8\nlet explosionTime = 0\nlet aircraftRoll = 0\nlet aircraftPitch = 0\nlet aircraftYaw = 0\n\nlet targetRoll = 0\nlet targetPitch = 0\nlet targetYaw = 0\n\nlet pilotState = 3\nlet pilotTimer = 0\nlet nextManeuver = randint(15000, 30000)\n\nlet maneuverDirection = 1\nlet pilotResponsiveness = 0.035\n\nlet cruiseSpeed = 200\nlet targetSpeed = 200\n// CAMERA AND MOUSE\nlet cameraYaw = 0\nlet cameraPitch = 0\nlet cameraVelocityX = 0\nlet cameraVelocityY = 0\nlet updown = 0\nlet focalLength = 120\nlet mouseX = 120\nlet mouseY = 90\nlet previousMouseX = 120\nlet previousMouseY = 90\nlet mouseDeltaX = 0\nlet mouseDeltaY = 0\nlet mouseInitialized = false\nlet mouseSensitivity = 0.15\nlet cameraFriction = 0.6\nlet mouseAcceleration = 0.008\nlet edgeMargin = 30\nlet edgeTurnSpeed = 1.2\n\n// CLOUDS\nlet cloudCount = 80\nlet cloudTravelSpeed = 1.5\nlet cloudX: number[] = []\nlet cloudY: number[] = []\nlet cloudZ: number[] = []\nlet cloudSize: number[] = []\n\n// AIRCRAFT BODY AND GUNS\nlet tailMovementX = 2.6\nlet tailMovementY = 2.3\nlet gunSwayX = 0\nlet gunSwayY = 0\nlet gunWeight = 0.15\nlet firing = false\nlet gunRecoil = 0\nlet muzzleFlash = 0\nlet fireTimer = 0\nlet fireInterval = 100\nlet shotThisFrame = false\nlet gunsBlocked = false\n\nlet bulletX: number[] = []\nlet bulletY: number[] = []\nlet bulletDepth: number[] = []\nlet bulletYaw: number[] = []\nlet bulletPitch: number[] = []\n// ENEMIES AND COMBAT\nlet enemyCount = 1\nlet enemyX: number[] = []\nlet enemyY: number[] = []\nlet enemyZ: number[] = []\nlet enemySpeed: number[] = []\nlet enemyPhase: number[] = []\nlet enemyHealth: number[] = []\nlet enemyCrashTime: number[] = []\nlet enemyRoll: number[] = []\nlet enemyCrashDirection: number[] = []\nlet smokeX: number[] = []\nlet smokeY: number[] = []\nlet smokeZ: number[] = []\nlet smokeAge: number[] = []\nlet enemyFireTimer: number[] = []\nlet enemySize = 180\nlet enemyTime = 0\nlet aircraftHealth = 50\nlet damageFlash = 0\nlet enemiesDestroyed = 0\nlet enemyBulletX: number[] = []\nlet enemyBulletY: number[] = []\nlet enemyBulletZ: number[] = []\n\n\n// IMAGES\nlet cloudImage = img`\n    ................................\n    .............11111..............\n    ...........111111111............\n    ......1111111111111111..........\n    ....111111111111111111111.......\n    ...111111111111111111111111.....\n    .1111111111111111111111111111...\n    111111111111111111111111111111..\n    1111111111111111111111111111111.\n    .11111111111111111111111111111..\n    ..dddd11111111dddd111111dddd....\n    ....dddddddddddddddddddddd......\n    ................................\n`\n\nlet enemyImage = img`\n    .................................\n    ...............333...............\n    ...............3b3...............\n    ..............33b33..............\n    ..............33333..............\n    .............3366633.............\n    ...333333333333333333333333333...\n    ..336666666666333336666666666633.\n    333333333333333333333333333333333\n    ..33333333333333333333333333333..\n    .............3aaa3...............\n    ..............3a3................\n    ...........333333333.............\n    ..............333................\n    .................................\n`\n\n// DRAWING HELPERS\n\nfunction getHorizon(screenPositionX: number) {\n    return Math.round(90 + updown + tilt * (screenPositionX - 120) / 120)\n}\n\nfunction fillTriangle(x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, col: number) {\n    let steps = Math.ceil(Math.max(1, Math.max(Math.abs(x3 - x2), Math.abs(y3 - y2))))\n    for (let step = 0; step <= steps; step++) {\n        let fraction = step / steps\n        let endX = x2 + (x3 - x2) * fraction\n        let endY = y2 + (y3 - y2) * fraction\n        terrain.drawLine(Math.round(x1), Math.round(y1), Math.round(endX), Math.round(endY), col)\n    }\n}\n\nfunction fillQuad(x1: number, y1: number, x2: number, y2: number, x3: number, y3: number, x4: number, y4: number, col: number) {\n    fillTriangle(x1, y1, x2, y2, x3, y3, col)\n    fillTriangle(x1, y1, x3, y3, x4, y4, col)\n}\n\nfunction drawScaledCloud(targetX: number, targetY: number, cloudScale: number) {\n    let cloudWidth = Math.max(1, Math.round(cloudImage.width * cloudScale))\n    let cloudHeight = Math.max(1, Math.round(cloudImage.height * cloudScale))\n    for (let px = 0; px <= cloudWidth - 1; px++) {\n        for (let py = 0; py <= cloudHeight - 1; py++) {\n            let sourceX = Math.floor(px * cloudImage.width / cloudWidth)\n            let sourceY = Math.floor(py * cloudImage.height / cloudHeight)\n            let pixelColor = cloudImage.getPixel(sourceX, sourceY)\n            let pixelX = Math.round(targetX + px - cloudWidth / 2)\n            let pixelY = Math.round(targetY + py - cloudHeight / 2)\n            let localHorizon = getHorizon(pixelX)\n            // Only draw visible cloud pixels above the ocean\n            if (pixelColor != 0 && pixelX >= 0 && pixelX < 240 && pixelY >= 0 && pixelY < 180 && pixelY < localHorizon) {\n                terrain.setPixel(pixelX, pixelY, pixelColor)\n            }\n        }\n    }\n}\n\nfunction drawScaledEnemy(\n    targetX: number,\n    targetY: number,\n    enemyScale: number\n) {\n\n    let enemyWidth = Math.max(\n        1, Math.round(enemyImage.width * enemyScale)\n    )\n\n    let enemyHeight = Math.max(\n        1, Math.round(enemyImage.height * enemyScale)\n    )\n\n    for (let px = 0; px < enemyWidth; px++) {\n\n        for (let py = 0; py < enemyHeight; py++) {\n\n            let sourceX = Math.floor(\n                px * enemyImage.width / enemyWidth\n            )\n\n            let sourceY = Math.floor(\n                py * enemyImage.height / enemyHeight\n            )\n\n            let pixelColor = enemyImage.getPixel(\n                sourceX, sourceY\n            )\n\n            let pixelX = Math.round(\n                targetX + px - enemyWidth / 2\n            )\n\n            let pixelY = Math.round(\n                targetY + py - enemyHeight / 2\n            )\n\n            if (\n                pixelColor != 0 &&\n                pixelX >= 0 &&\n                pixelX < 240 &&\n                pixelY >= 0 &&\n                pixelY < 180\n            ) {\n\n                terrain.setPixel(\n                    pixelX, pixelY, pixelColor\n                )\n            }\n        }\n    }\n}\n\n// CLOUD RENDERING\n\nfunction renderClouds() {\n    let yawRadians = getViewYaw() * Math.PI / 180\n\n    let pitchRadians = -Math.max(\n        -80, Math.min(80, getViewPitch())\n    ) * Math.PI / 180\n    // Calculate trigonometric values once\n    let cosYaw = Math.cos(yawRadians)\n    let sinYaw = Math.sin(yawRadians)\n    let cosPitch = Math.cos(pitchRadians)\n    let sinPitch = Math.sin(pitchRadians)\n    for (let cloudIndex2 = 0; cloudIndex2 <= cloudCount - 1; cloudIndex2++) {\n        cloudZ[cloudIndex2] += speed / 200 * cloudTravelSpeed\n        // Recycle distant clouds\n        if (cloudZ[cloudIndex2] > 2200) {\n            cloudZ[cloudIndex2] = -2200\n            cloudX[cloudIndex2] = randint(-2000, 2000)\n            cloudY[cloudIndex2] = randint(-450, -120)\n            cloudSize[cloudIndex2] = randint(80, 220)\n        }\n        // Horizontal camera rotation\n        let rotatedX = cloudX[cloudIndex2] * cosYaw - cloudZ[cloudIndex2] * sinYaw\n        let rotatedZ = cloudX[cloudIndex2] * sinYaw + cloudZ[cloudIndex2] * cosYaw\n        // Vertical camera rotation\n        let rotatedY = cloudY[cloudIndex2] * cosPitch - rotatedZ * sinPitch\n        let cloudDepth = cloudY[cloudIndex2] * sinPitch + rotatedZ * cosPitch\n        // Only render clouds in front of the camera\n        if (cloudDepth > 100) {\n            let projectedX = rotatedX * focalLength / cloudDepth\n            let projectedY = rotatedY * focalLength / cloudDepth\n            let cloudScreenX = 120 + projectedX\n            let cloudScreenY = 90 + projectedY\n            // Aircraft banking\n            cloudScreenY += tilt * projectedX / 120\n            // Perspective scaling\n            let cloudScale = cloudSize[cloudIndex2] / cloudDepth * 3\n            cloudScale = Math.min(3, cloudScale)\n            // Only draw clouds near the screen\n            if (cloudScreenX > -100 && cloudScreenX < 340 && cloudScreenY > -50 && cloudScreenY < 230) {\n                drawScaledCloud(cloudScreenX, cloudScreenY, cloudScale)\n            }\n        }\n    }\n}\n\n// AIRCRAFT AND GUN RENDERING\n\nfunction renderAircraftBody() {\n    let ox = -cameraYaw * tailMovementX\n    let oy = cameraPitch * tailMovementY\n    // EXTENDED FUSELAGE\n    fillQuad(70 + ox, 180 + oy, 170 + ox, 180 + oy, 235 + ox, 280 + oy, 5 + ox, 280 + oy, 6)\n    // LEFT SIDE HIGHLIGHT\n    fillQuad(70 + ox, 180 + oy, 91 + ox, 180 + oy, 48 + ox, 280 + oy, 5 + ox, 280 + oy, 11)\n    // RIGHT SIDE SHADOW\n    fillQuad(149 + ox, 180 + oy, 170 + ox, 180 + oy, 235 + ox, 280 + oy, 192 + ox, 280 + oy, 10)\n    // COCKPIT OPENING\n    fillQuad(91 + ox, 187 + oy, 149 + ox, 187 + oy, 187 + ox, 280 + oy, 53 + ox, 280 + oy, 3)\n    // INTERIOR FLOOR\n    fillQuad(104 + ox, 194 + oy, 136 + ox, 194 + oy, 152 + ox, 239 + oy, 88 + ox, 239 + oy, 10)\n    // LEFT COCKPIT RIM\n    terrain.drawLine(91 + ox, 187 + oy, 53 + ox, 280 + oy, 11)\n    // RIGHT COCKPIT RIM\n    terrain.drawLine(149 + ox, 187 + oy, 187 + ox, 280 + oy, 11)\n    // SEAT\n    fillQuad(100 + ox, 247 + oy, 140 + ox, 247 + oy, 146 + ox, 280 + oy, 94 + ox, 280 + oy, 12)\n    // COCKPIT RIVETS\n    for (let rivet = 0; rivet <= 5; rivet++) {\n        terrain.setPixel(Math.round(77 - rivet * 5 + ox), Math.round(188 + rivet * 13 + oy), 3)\n        terrain.setPixel(Math.round(163 + rivet * 5 + ox), Math.round(188 + rivet * 13 + oy), 3)\n    }\n    // LEFT HORIZONTAL STABILIZER\n    fillQuad(117 + ox, 117 + oy, 92 + ox, 102 + oy, 47 + ox, 106 + oy, 40 + ox, 114 + oy, 6)\n    fillTriangle(40 + ox, 114 + oy, 117 + ox, 117 + oy, 117 + ox, 128 + oy, 10)\n    // RIGHT HORIZONTAL STABILIZER\n    fillQuad(123 + ox, 117 + oy, 148 + ox, 102 + oy, 193 + ox, 106 + oy, 200 + ox, 114 + oy, 6)\n    fillTriangle(200 + ox, 114 + oy, 123 + ox, 117 + oy, 123 + ox, 128 + oy, 10)\n    // MAIN FUSELAGE\n    fillQuad(70 + ox, 180 + oy, 114 + ox, 111 + oy, 126 + ox, 111 + oy, 170 + ox, 180 + oy, 6)\n    // FUSELAGE HIGHLIGHT\n    fillQuad(70 + ox, 180 + oy, 114 + ox, 111 + oy, 118 + ox, 111 + oy, 105 + ox, 180 + oy, 11)\n    // FUSELAGE SHADOW\n    fillQuad(126 + ox, 111 + oy, 170 + ox, 180 + oy, 140 + ox, 180 + oy, 124 + ox, 111 + oy, 10)\n    // VERTICAL STABILIZER\n    fillQuad(114 + ox, 116 + oy, 115 + ox, 79 + oy, 120 + ox, 55 + oy, 130 + ox, 116 + oy, 6)\n    // RUDDER\n    fillQuad(120 + ox, 55 + oy, 126 + ox, 55 + oy, 131 + ox, 65 + oy, 130 + ox, 116 + oy, 10)\n    // RUDDER HINGE\n    terrain.drawLine(124 + ox, 64 + oy, 124 + ox, 112 + oy, 3)\n    // PANEL LINES\n    terrain.drawLine(91 + ox, 150 + oy, 149 + ox, 150 + oy, 3)\n    terrain.drawLine(80 + ox, 168 + oy, 160 + ox, 168 + oy, 3)\n    // RIVETS\n    for (let rivet2 = 0; rivet2 <= 6; rivet2++) {\n        terrain.setPixel(Math.round(95 + rivet2 * 8 + ox), Math.round(153 + oy), 3)\n    }\n}\n\nfunction updateGunSway() {\n\n    // Smooth gun sway\n    gunSwayX += (\n        -cameraVelocityX * 2 - gunSwayX\n    ) * gunWeight\n\n    gunSwayY += (\n        -cameraVelocityY * 2 - gunSwayY\n    ) * gunWeight\n\n}\n\nfunction renderGuns() {\n    let gx = gunSwayX\n    let gy = gunSwayY + gunRecoil\n\n    // CENTRAL MOUNT\n    fillQuad(\n        85 + gx, 200 + gy,\n        105 + gx, 146 + gy,\n        135 + gx, 146 + gy,\n        155 + gx, 200 + gy,\n        10\n    )\n\n    // DRAW BOTH GUNS\n    for (let gunIndex = 0; gunIndex < 2; gunIndex++) {\n\n        let side = gunIndex * 2 - 1\n\n        // Perspective coordinates\n        let rearX = 120 + side * 55 + gx\n        let middleX = 120 + side * 30 + gx\n        let frontX = 120 + side * 9 + gx\n\n        // BARREL\n        fillQuad(\n            middleX - 5, 143 + gy,\n            frontX - 2, 98 + gy,\n            frontX + 2, 98 + gy,\n            middleX + 5, 143 + gy,\n            10\n        )\n\n        // BARREL HIGHLIGHT\n        terrain.drawLine(\n            Math.round(middleX - 3),\n            Math.round(143 + gy),\n            Math.round(frontX - 1),\n            Math.round(98 + gy),\n            11\n        )\n\n        // BARREL TIP\n        terrain.fillRect(\n            Math.round(frontX - 2),\n            Math.round(96 + gy),\n            4, 4, 3\n        )\n\n        // MAIN RECEIVER\n        fillQuad(\n            rearX - 13, 200 + gy,\n            middleX - 6, 137 + gy,\n            middleX + 6, 137 + gy,\n            rearX + 13, 200 + gy,\n            3\n        )\n\n        // UPPER RECEIVER SURFACE\n        fillQuad(\n            rearX - 9, 200 + gy,\n            middleX - 4, 139 + gy,\n            middleX + 3, 139 + gy,\n            rearX + 5, 200 + gy,\n            10\n        )\n\n        // RECEIVER HIGHLIGHT\n        terrain.drawLine(\n            Math.round(rearX - 8),\n            Math.round(200 + gy),\n            Math.round(middleX - 3),\n            Math.round(139 + gy),\n            11\n        )\n    }\n\n    // CONNECTING SUPPORT\n    fillQuad(\n        83 + gx, 169 + gy,\n        157 + gx, 169 + gy,\n        162 + gx, 178 + gy,\n        78 + gx, 178 + gy,\n        12\n    )\n}\n\n// Render the existing body to a transparent layer and test the aim against it.\nfunction updateGunObstruction() {\n\n    // Draw aircraft onto a transparent layer\n    aircraftLayer.fill(0)\n\n    let background = terrain\n    terrain = aircraftLayer\n\n    renderAircraftBody()\n\n    terrain = background\n\n    // Reset obstruction every frame\n    gunsBlocked = false\n\n    // Get actual aiming position\n    let aimX = Math.round(120 + gunSwayX)\n    let aimY = Math.round(90 + gunSwayY)\n\n    // Check aircraft pixels around the crosshair\n    for (let dx = -1; dx <= 1; dx++) {\n        for (let dy = -1; dy <= 1; dy++) {\n\n            if (aircraftLayer.getPixel(\n                aimX + dx,\n                aimY + dy\n            ) != 0) {\n\n                gunsBlocked = true\n            }\n        }\n    }\n}\n\nfunction renderSight() {\n    let sightX = Math.round(120 + gunSwayX)\n    let sightY = Math.round(90 + gunSwayY)\n    let sightColor = gunsBlocked ? 2 : 3\n    terrain.drawCircle(sightX, sightY, 10, sightColor)\n    terrain.drawCircle(sightX, sightY, 3, sightColor)\n    terrain.drawLine(sightX - 15, sightY, sightX - 6, sightY, sightColor)\n    terrain.drawLine(sightX + 6, sightY, sightX + 15, sightY, sightColor)\n    terrain.drawLine(sightX, sightY - 15, sightX, sightY - 6, sightColor)\n    terrain.drawLine(sightX, sightY + 6, sightX, sightY + 15, sightColor)\n    if (gunsBlocked) {\n        terrain.fillRect(81, 38, 78, 12, 3)\n        terrain.print(\"GUNS BLOCKED\", 85, 40, 2)\n    }\n}\n\n// PLAYER FIRING\n\nfunction fireGuns() {\n\n    if (gunsBlocked) {\n        return\n    }\n\n    // Generate both visual tracers\n    for (let gunIndex = 0; gunIndex < 2; gunIndex++) {\n\n        let side = gunIndex * 2 - 1\n\n        bulletX.push(side * 9)\n        bulletY.push(8)\n        bulletDepth.push(1)\n\n        // Remember original firing direction\n        bulletYaw.push(getViewYaw())\n        bulletPitch.push(getViewPitch())\n    }\n\n    gunRecoil = 4\n    muzzleFlash = 1\n    shotThisFrame = true\n}\nfunction updateFiring() {\n\n    shotThisFrame = false\n\n    fireTimer += 33\n\n    if (firing && !gunsBlocked &&\n        fireTimer >= fireInterval) {\n\n        fireGuns()\n        fireTimer = 0\n    }\n\n    gunRecoil *= 0.65\n}\n\n\nfunction renderBullets() {\n\n    for (let i = bulletDepth.length - 1; i >= 0; i--) {\n\n        bulletDepth[i] += 0.18\n\n        let perspective = 1 / bulletDepth[i]\n\n        // Difference between original and current view\n        let relativeYaw =\n            (bulletYaw[i] - getViewYaw()) * Math.PI / 180\n\n        let relativePitch =\n            (getViewPitch() - bulletPitch[i]) * Math.PI / 180\n\n        // Only render tracers within the camera's view\n        if (\n            Math.abs(relativeYaw) < 1.4 &&\n            Math.abs(relativePitch) < 1.4\n        ) {\n\n            let bx = 120 +\n                Math.tan(relativeYaw) * focalLength +\n                bulletX[i] * perspective\n\n            let by = 90 +\n                Math.tan(relativePitch) * focalLength +\n                bulletY[i] * perspective\n\n            let trailPerspective = 1 / Math.max(\n                1, bulletDepth[i] - 0.5\n            )\n\n            let trailX = 120 +\n                Math.tan(relativeYaw) * focalLength +\n                bulletX[i] * trailPerspective\n\n            let trailY = 90 +\n                Math.tan(relativePitch) * focalLength +\n                bulletY[i] * trailPerspective\n\n            // NEW: Apply aircraft banking\n            by += tilt * (bx - 120) / 120\n            trailY += tilt * (trailX - 120) / 120\n\n            if (\n                bx >= 0 && bx < 240 &&\n                by >= 0 && by < 180\n            ) {\n\n                // Orange tracer trail\n                terrain.drawLine(\n                    Math.round(trailX),\n                    Math.round(trailY),\n                    Math.round(bx),\n                    Math.round(by),\n                    4\n                )\n\n                // Yellow tracer core\n                terrain.fillRect(\n                    Math.round(bx),\n                    Math.round(by),\n                    2, 2, 5\n                )\n            }\n        }\n\n        // Remove expired tracers\n        if (bulletDepth[i] > 5) {\n\n            bulletX.removeAt(i)\n            bulletY.removeAt(i)\n            bulletDepth.removeAt(i)\n            bulletYaw.removeAt(i)\n            bulletPitch.removeAt(i)\n        }\n    }\n}\n\n\nfunction renderMuzzleFlash() {\n\n    if (muzzleFlash > 0) {\n\n        for (let gunIndex = 0; gunIndex < 2; gunIndex++) {\n\n            let side = gunIndex * 2 - 1\n\n            let fx = 120 + side * 9 + gunSwayX\n            let fy = 98 + gunSwayY + gunRecoil\n\n            // Outer flash\n            fillTriangle(\n                fx - 4, fy,\n                fx + 4, fy,\n                fx, fy - randint(4, 7),\n                4\n            )\n\n            // Inner flash\n            fillTriangle(\n                fx - 2, fy,\n                fx + 2, fy,\n                fx, fy - 4,\n                5\n            )\n\n            // White core\n            terrain.setPixel(\n                Math.round(fx),\n                Math.round(fy - 1),\n                1\n            )\n        }\n\n        muzzleFlash -= 1\n    }\n}\n\n// ENEMY SPAWNING AND MOVEMENT\n\nfunction spawnEnemy(enemyIndex: number) {\n\n    enemyX[enemyIndex] = randint(-500, 500)\n    enemyY[enemyIndex] = randint(-250, 100)\n    enemyZ[enemyIndex] = randint(2500, 4500)\n    enemyBreakingAway[enemyIndex] = 0\n    enemyTurnTime[enemyIndex] = 0\n    enemyTurnDirection[enemyIndex] = randint(0, 1) * 2 - 1\n    enemySpeed[enemyIndex] = randint(3, 6)\n    enemyPhase[enemyIndex] = randint(0, 628) / 100\n\n    enemyCrashTime[enemyIndex] = 0\n    enemyRoll[enemyIndex] = 0\n    enemyCrashDirection[enemyIndex] = 1\n    enemyHealth[enemyIndex] = 50\n    enemyFireTimer[enemyIndex] = randint(200, 1000)\n}\n\nfunction updateEnemies() {\n\n    enemyTime += 0.033\n\n    for (let enemyIndex = 0; enemyIndex < enemyCount; enemyIndex++) {\n\n        // Destroyed aircraft lose control and spiral downward.\n        if (enemyHealth[enemyIndex] <= 0) {\n            enemyCrashTime[enemyIndex] += 1\n            let crashTime = enemyCrashTime[enemyIndex]\n            enemyRoll[enemyIndex] += 0.15 * enemyCrashDirection[enemyIndex]\n            enemyX[enemyIndex] += Math.cos(enemyRoll[enemyIndex]) * 8\n            enemyY[enemyIndex] += 2 + crashTime * 0.09 + Math.sin(enemyRoll[enemyIndex]) * 1.5\n            enemyZ[enemyIndex] += 2\n            if (crashTime % 3 == 0) {\n                smokeX.push(enemyX[enemyIndex])\n                smokeY.push(enemyY[enemyIndex])\n                smokeZ.push(enemyZ[enemyIndex])\n                smokeAge.push(0)\n            }\n            if (crashTime >= 150) {\n                spawnEnemy(enemyIndex)\n            }\n            continue\n        }\n\n        // Approach the player's aircraft\n        enemyZ[enemyIndex] -= enemySpeed[enemyIndex]\n\n        // Horizontal movement\n        enemyX[enemyIndex] += Math.sin(\n            enemyTime * 1.2 + enemyPhase[enemyIndex]\n        ) * 2\n\n        // Vertical movement\n        enemyY[enemyIndex] += Math.cos(\n            enemyTime * 0.8 + enemyPhase[enemyIndex]\n        ) * 0.7\n\n        // Recycle aircraft that get too close\n        if (enemyZ[enemyIndex] < 180) {\n\n            spawnEnemy(enemyIndex)\n        }\n    }\n}\n\nfunction renderEnemies() {\n\n    let yawRadians = getViewYaw() * Math.PI / 180\n\n    let pitchRadians = -Math.max(\n        -80, Math.min(80, getViewPitch())\n    ) * Math.PI / 180\n\n    let cosYaw = Math.cos(yawRadians)\n    let sinYaw = Math.sin(yawRadians)\n\n    let cosPitch = Math.cos(pitchRadians)\n    let sinPitch = Math.sin(pitchRadians)\n\n    let hitEnemy = -1\n    let nearestHitDepth = 1000000\n\n    for (let enemyIndex = 0; enemyIndex < enemyCount; enemyIndex++) {\n\n        // Horizontal camera rotation\n        let rotatedX =\n            enemyX[enemyIndex] * cosYaw -\n            enemyZ[enemyIndex] * sinYaw\n\n        let rotatedZ =\n            enemyX[enemyIndex] * sinYaw +\n            enemyZ[enemyIndex] * cosYaw\n\n        // Vertical camera rotation\n        let rotatedY =\n            enemyY[enemyIndex] * cosPitch -\n            rotatedZ * sinPitch\n\n        let enemyDepth =\n            enemyY[enemyIndex] * sinPitch +\n            rotatedZ * cosPitch\n\n        // Only render visible aircraft\n        if (enemyDepth > 100) {\n\n            let projectedX =\n                rotatedX * focalLength / enemyDepth\n\n            let projectedY =\n                rotatedY * focalLength / enemyDepth\n\n            let enemyScreenX = 120 + projectedX\n            let enemyScreenY = 90 + projectedY\n\n            // Aircraft banking\n            enemyScreenY += tilt * projectedX / 120\n\n            // Perspective scaling\n            let enemyScale =\n                enemySize / enemyDepth * 3\n\n            enemyScale = Math.min(3, enemyScale)\n\n            // One damage event per firing cycle; select nearest overlapping target.\n            let hitWidth = enemyImage.width * enemyScale / 2\n            let hitHeight = enemyImage.height * enemyScale / 2\n            if (enemyHealth[enemyIndex] > 0 && shotThisFrame &&\n                Math.abs(120 + gunSwayX - enemyScreenX) < hitWidth &&\n                Math.abs(90 + gunSwayY - enemyScreenY) < hitHeight &&\n                enemyDepth < nearestHitDepth) {\n                hitEnemy = enemyIndex\n                nearestHitDepth = enemyDepth\n            }\n\n            if (\n                enemyScreenX > -100 &&\n                enemyScreenX < 340 &&\n                enemyScreenY > -50 &&\n                enemyScreenY < 230\n            ) {\n\n                if (enemyHealth[enemyIndex] <= 0) {\n                    drawCrashingEnemy(enemyScreenX, enemyScreenY, enemyScale, enemyRoll[enemyIndex])\n                } else {\n                    drawScaledEnemy(enemyScreenX, enemyScreenY, enemyScale)\n                }\n            }\n        }\n    }\n    if (hitEnemy >= 0) {\n        enemyHealth[hitEnemy] -= 10\n        if (enemyHealth[hitEnemy] <= 0) {\n            enemiesDestroyed += 1\n            enemyCrashTime[hitEnemy] = 0\n            enemyCrashDirection[hitEnemy] = randint(0, 1) * 2 - 1\n        }\n    }\n}\n\n// CRASH ANIMATION AND WORLD-SPACE SMOKE\n\nfunction drawCrashingEnemy(cx: number, cy: number, scale: number, roll: number) {\n    let cosine = Math.cos(roll)\n    let sine = Math.sin(roll)\n    let w = Math.max(1, Math.round(enemyImage.width * scale))\n    let h = Math.max(1, Math.round(enemyImage.height * scale))\n    let radius = Math.ceil(Math.sqrt(w * w + h * h) / 2)\n    // Inverse rotation avoids gaps between enlarged pixels.\n    for (let dx = -radius; dx <= radius; dx++) {\n        for (let dy = -radius; dy <= radius; dy++) {\n            let sx = Math.floor((dx * cosine + dy * sine + w / 2) * enemyImage.width / w)\n            let sy = Math.floor((-dx * sine + dy * cosine + h / 2) * enemyImage.height / h)\n            if (sx >= 0 && sx < enemyImage.width && sy >= 0 && sy < enemyImage.height) {\n                let c = enemyImage.getPixel(sx, sy)\n                if (c != 0) {\n                    terrain.setPixel(Math.round(cx + dx), Math.round(cy + dy), c)\n                }\n            }\n        }\n    }\n    let flameSize = Math.max(2, Math.round(scale * 5))\n    fillTriangle(cx - flameSize, cy, cx + flameSize, cy, cx + randint(-flameSize, flameSize), cy - flameSize * 2, 4)\n    fillTriangle(cx - flameSize / 2, cy, cx + flameSize / 2, cy, cx, cy - flameSize, 5)\n    terrain.setPixel(Math.round(cx), Math.round(cy), 1)\n}\n\nfunction renderCrashSmoke() {\n    let yaw = getViewYaw() * Math.PI / 180\n\n    let pitch = -Math.max(\n        -80, Math.min(80, getViewPitch())\n    ) * Math.PI / 180\n    let cyaw = Math.cos(yaw)\n    let syaw = Math.sin(yaw)\n    let cpitch = Math.cos(pitch)\n    let spitch = Math.sin(pitch)\n    for (let i = smokeAge.length - 1; i >= 0; i--) {\n        smokeAge[i] += 1\n        smokeZ[i] += speed / 200 * cloudTravelSpeed\n        smokeY[i] -= 0.5\n        if (smokeAge[i] > 75) {\n            smokeX.removeAt(i)\n            smokeY.removeAt(i)\n            smokeZ.removeAt(i)\n            smokeAge.removeAt(i)\n        } else {\n            let rx = smokeX[i] * cyaw - smokeZ[i] * syaw\n            let rz = smokeX[i] * syaw + smokeZ[i] * cyaw\n            let ry = smokeY[i] * cpitch - rz * spitch\n            let depth = smokeY[i] * spitch + rz * cpitch\n            if (depth > 100) {\n                let x = 120 + rx * focalLength / depth\n                let y = 90 + ry * focalLength / depth + tilt * (x - 120) / 120\n                let r = Math.max(1, Math.min(9, Math.round((18 + smokeAge[i] * 0.8) * focalLength / depth)))\n                let c = 3\n                if (smokeAge[i] > 25) c = 10\n                if (smokeAge[i] > 50) c = 12\n                if (x > -10 && x < 250 && y > -10 && y < 190) {\n                    terrain.fillCircle(Math.round(x), Math.round(y), r, c)\n                }\n            }\n        }\n    }\n}\n\n// ENEMY FIRING AND DAMAGE\n\n\nfunction updateEnemyFiring() {\n\n    for (let i = 0; i < enemyCount; i++) {\n\n        // Destroyed aircraft cannot fire\n        if (enemyHealth[i] > 0) {\n\n            enemyFireTimer[i] -= 33\n\n            if (\n                enemyZ[i] < 900 &&\n                enemyZ[i] > 180 &&\n                enemyFireTimer[i] <= 0\n            ) {\n\n                enemyBulletX.push(enemyX[i])\n                enemyBulletY.push(enemyY[i])\n                enemyBulletZ.push(enemyZ[i])\n\n                enemyFireTimer[i] = randint(\n                    200,\n                    800\n                )\n            }\n        }\n    }\n}\n\n\n\nfunction updateEnemyBullets() {\n\n    for (let i = enemyBulletZ.length - 1; i >= 0; i--) {\n\n        // Incoming projectile movement\n        enemyBulletZ[i] -= 35\n\n        enemyBulletX[i] *= 0.94\n        enemyBulletY[i] *= 0.94\n\n        // Projectile reaches aircraft\n        if (enemyBulletZ[i] <= 40) {\n\n            if (randint(1, 100) <= 35) {\n\n                aircraftHealth = Math.max(\n                    0,\n                    aircraftHealth - randint(4,7)\n                )\n\n                damageFlash = 3\n            }\n\n            // Remove projectile\n            enemyBulletX.removeAt(i)\n            enemyBulletY.removeAt(i)\n            enemyBulletZ.removeAt(i)\n        }\n    }\n}\n\nfunction renderEnemyBullets() {\n\n    let yawRadians = getViewYaw() * Math.PI / 180\n\n    let pitchRadians = -Math.max(\n        -80, Math.min(80, getViewPitch())\n    ) * Math.PI / 180\n\n    let cosYaw = Math.cos(yawRadians)\n    let sinYaw = Math.sin(yawRadians)\n\n    let cosPitch = Math.cos(pitchRadians)\n    let sinPitch = Math.sin(pitchRadians)\n\n    for (let i = 0; i < enemyBulletZ.length; i++) {\n\n        let rx =\n            enemyBulletX[i] * cosYaw -\n            enemyBulletZ[i] * sinYaw\n\n        let rz =\n            enemyBulletX[i] * sinYaw +\n            enemyBulletZ[i] * cosYaw\n\n        let ry =\n            enemyBulletY[i] * cosPitch -\n            rz * sinPitch\n\n        let bulletDistance =\n            enemyBulletY[i] * sinPitch +\n            rz * cosPitch\n\n        if (bulletDistance > 40) {\n\n            let bx = 120 +\n                rx * focalLength / bulletDistance\n\n            let by = 90 +\n                ry * focalLength / bulletDistance\n\n            by += tilt * (bx - 120) / 120\n\n            let bulletSize = Math.max(\n                1,\n                Math.min(5, 300 / bulletDistance)\n            )\n\n            terrain.fillRect(\n                Math.round(bx),\n                Math.round(by),\n                Math.round(bulletSize),\n                Math.round(bulletSize),\n                4\n            )\n        }\n    }\n}\n\n\nfunction renderCombatHUD() {\n\n    let healthPercentage =\n        aircraftHealth / 50\n\n    let healthColor = 7\n\n    if (healthPercentage <= 0.3) {\n        healthColor = 2\n    } else if (healthPercentage <= 0.6) {\n        healthColor = 5\n    }\n\n    // Health panel\n    terrain.fillRect(5, 5, 79, 27, 3)\n\n    terrain.print(\n        \"HP \" + aircraftHealth + \"/\" + 50,\n        9, 8, 1\n    )\n\n    // Health bar background\n    terrain.fillRect(9, 21, 70, 6, 12)\n\n    // Current health bar\n    terrain.fillRect(\n        9, 21,\n        Math.round(70 * healthPercentage),\n        6, healthColor\n    )\n\n    // Kill counter\n    terrain.fillRect(180, 5, 55, 15, 3)\n\n    terrain.print(\n        \"Kills \" + enemiesDestroyed,\n        185, 8, 1\n    )\n\n    // Damage flash\n    if (damageFlash > 0) {\n\n        terrain.drawRect(0, 0, 240, 180, 2)\n        terrain.drawRect(1, 1, 238, 178, 2)\n        terrain.drawRect(2, 2, 236, 176, 2)\n\n        damageFlash -= 1\n    }\n\n    // Critical damage warning\n    if (healthPercentage <= 0.3) {\n\n        terrain.print(\n            \"Low HP\",\n            70, 35, 2\n        )\n    }\n\n    // Aircraft destroyed\n    if (aircraftHealth <= 0) {\n        game.over(false)\n    }\n}\n\n\n// INITIALIZATION\nscene.setBackgroundImage(terrain)\n\nfor (let index = 0; index < cloudCount; index++) {\n    let spawnAngle = randint(0, 359) * Math.PI / 180\n    let spawnDistance = randint(200, 2000)\n    cloudX.push(Math.sin(spawnAngle) * spawnDistance)\n    cloudZ.push(Math.cos(spawnAngle) * spawnDistance)\n    cloudY.push(randint(-450, -120))\n    cloudSize.push(randint(80, 220))\n}\n\nfor (let enemyIndex = 0; enemyIndex < enemyCount; enemyIndex++) {\n    enemyX.push(0)\n    enemyY.push(0)\n    enemyZ.push(0)\n    enemySpeed.push(0)\n    enemyPhase.push(0)\n    enemyHealth.push(0)\n    enemyCrashTime.push(0)\n    enemyRoll.push(0)\n    enemyCrashDirection.push(1)\n    enemyFireTimer.push(0)\n    spawnEnemy(enemyIndex)\n}\n\n// INPUT EVENTS\n\nbrowserEvents.R.onEvent(browserEvents.KeyEvent.Pressed, function () {\n    cameraYaw = 0\n    cameraPitch = 0\n    cameraVelocityX = 0\n    cameraVelocityY = 0\n    mouseDeltaX = 0\n    mouseDeltaY = 0\n    mouseInitialized = false\n    updown = 0\n})\n\nbrowserEvents.onMouseMove(function (x, y) {\n    mouseX = x\n    mouseY = y\n    if (mouseInitialized) {\n        mouseDeltaX += x - previousMouseX\n        mouseDeltaY += previousMouseY - y\n    }\n    previousMouseX = x\n    previousMouseY = y\n    mouseInitialized = true\n})\n\nforever(function () {\n    if (browserEvents.MouseLeft.isPressed()) {\n        firing = true\n    } else {\n        firing = false\n    }\n    pause(10)\n})\n\n// CAMERA UPDATE\n\ngame.onUpdate(function () {\n    // Normal mouse acceleration\n    cameraVelocityX += mouseDeltaX * (mouseSensitivity + Math.abs(mouseDeltaX) * mouseAcceleration)\n    cameraVelocityY += mouseDeltaY * (mouseSensitivity + Math.abs(mouseDeltaY) * mouseAcceleration)\n    // Limit camera velocity\n    cameraVelocityX = Math.max(-6, Math.min(6, cameraVelocityX))\n    cameraVelocityY = Math.max(-6, Math.min(6, cameraVelocityY))\n    let edgeX = 0\n    let edgeY = 0\n    if (mouseInitialized) {\n        // Left edge\n        if (mouseX < edgeMargin) {\n            edgeX = (0 - (edgeMargin - mouseX)) / edgeMargin\n        }\n        // Right edge\n        if (mouseX > 240 - edgeMargin) {\n            edgeX = (mouseX - (240 - edgeMargin)) / edgeMargin\n        }\n        // Top edge\n        if (mouseY < edgeMargin) {\n            edgeY = (edgeMargin - mouseY) / edgeMargin\n        }\n        // Bottom edge\n        if (mouseY > 180 - edgeMargin) {\n            edgeY = (0 - (mouseY - (180 - edgeMargin))) / edgeMargin\n        }\n    }\n    // Limit edge input\n    edgeX = Math.max(-1, Math.min(1, edgeX))\n    edgeY = Math.max(-1, Math.min(1, edgeY))\n    // Smooth edge acceleration\n    edgeX = edgeX * Math.abs(edgeX)\n    edgeY = edgeY * Math.abs(edgeY)\n    // Update camera orientation\n    cameraYaw += cameraVelocityX + edgeX * edgeTurnSpeed\n    cameraPitch += cameraVelocityY + edgeY * edgeTurnSpeed\n    // Camera rotation limits\n    cameraYaw = Math.max(-80, Math.min(80, cameraYaw))\n    cameraPitch = Math.max(-45, Math.min(45, cameraPitch))\n    cameraVelocityX *= cameraFriction\n    cameraVelocityY *= cameraFriction\n    // Clear mouse movement\n    mouseDeltaX = 0\n    mouseDeltaY = 0\n    // Update horizon\n    updown = focalLength * Math.tan(cameraPitch * Math.PI / 180)\n})\n\n// MAIN RENDER LOOP\n\ngame.onUpdateInterval(33, function () {\n    // Draw sky\n    terrain.fill(9)\n    // Draw ocean\n    for (let x = 0; x <= 239; x++) {\n        let horizon = getHorizon(x)\n        if (horizon < 180) {\n            terrain.drawLine(x, Math.max(0, horizon), x, 179, 8)\n        }\n        // Dithered atmospheric gradient\n        for (let d = 0; d <= 23; d++) {\n            let y = horizon + d\n            if (y >= 0 && y < 180) {\n                if (d < 5) {\n                    if ((x + d) % 2 == 0) {\n                        terrain.setPixel(x, y, 9)\n                    }\n                } else if (d < 13) {\n                    if (x % 2 == 0 && d % 2 == 0) {\n                        terrain.setPixel(x, y, 9)\n                    }\n                } else {\n                    if (x % 4 == 0 && d % 4 == 0) {\n                        terrain.setPixel(x, y, 9)\n                    }\n                }\n            }\n        }\n    }\n    // Ocean movement\n    travel += speed / 200\n    travel = travel % 100\n    // Moving ocean waves\n    for (let waveIndex = 0; waveIndex <= 79; waveIndex++) {\n        let waveX = (waveIndex * 73 + 31 - getViewYaw() * 2 + 480) % 240\n        let waveDepth = (waveIndex * 37 + 100 - travel) % 100 / 100\n        let waveDistance = 180 * waveDepth * waveDepth\n        let waveY = getHorizon(waveX) + waveDistance\n        if (waveDistance > 24) {\n            let waveWidth = 1 + waveDepth * waveDepth * 12\n            terrain.drawLine(Math.round(waveX), Math.round(waveY), Math.round(waveX + waveWidth), Math.round(waveY + tilt * waveWidth / 120), 6)\n        }\n    }\n    updatePilotAI()\n    updateBombingMission()\n    renderClouds()\n    renderCarrier()\n    renderCarrierExplosion()\n    updateGunObstruction()\n    updateFiring()\n\n    updateEnemies()\n    updateEnemyFiring()\n    updateEnemyBullets()\n\n    renderEnemies()\n    renderEnemyBullets()\n    renderBullets()\n\n    renderAircraftBody()\n    renderGuns()\n    renderMuzzleFlash()\n    renderSight()\n\n    renderCombatHUD()\n    renderCombatHUD()\n    renderBombMessage()\n})\n\nfunction updatePilotAI() {\n\n    pilotTimer += 33\n\n    // Check for nearby enemy aircraft\n    let enemyNearby = false\n\n    for (let i = 0; i < enemyCount; i++) {\n        if (enemyHealth[i] > 0 &&\n            enemyZ[i] < 1000) {\n\n            enemyNearby = true\n        }\n    }\n\n    // STATE 0: NORMAL CRUISE\n    if (pilotState == 0) {\n\n        targetRoll = Math.sin(pilotTimer / 1800) * 2\n        targetPitch = Math.sin(pilotTimer / 2300) * 1.5\n        targetYaw = 0\n        targetSpeed = cruiseSpeed\n\n        if (pilotTimer >= nextManeuver ||\n            (enemyNearby && pilotTimer > 8000)) {\n\n            if (bombReleased) {\n                pilotState = randint(1, 2)\n            } else {\n                pilotState = randint(1, 3)\n            }\n            pilotTimer = 0\n\n            maneuverDirection = randint(0, 1) * 2 - 1\n        }\n    }\n\n    // STATE 1: EVASIVE BANK\n    else if (pilotState == 1) {\n\n        targetRoll = maneuverDirection * 40\n        targetYaw = maneuverDirection * 12\n        targetPitch = 3\n        targetSpeed = 215\n\n        if (pilotTimer > 2200) {\n            pilotState = 4\n            pilotTimer = 0\n        }\n    }\n\n    // STATE 2: SWERVING\n    else if (pilotState == 2) {\n\n        if (pilotTimer < 1600) {\n\n            targetRoll = maneuverDirection * 35\n            targetYaw = maneuverDirection * 15\n\n        } else {\n\n            targetRoll = -maneuverDirection * 40\n            targetYaw = -maneuverDirection * 15\n        }\n\n        targetPitch = 0\n        targetSpeed = 210\n\n        if (pilotTimer > 3500) {\n            pilotState = 4\n            pilotTimer = 0\n        }\n    }\n\n    // STATE 3: STEEP DIVE\n    else if (pilotState == 3) {\n\n        targetRoll = maneuverDirection * 12\n        targetPitch = -38\n        targetYaw = maneuverDirection * 5\n        targetSpeed = 280\n\n        if (pilotTimer > 3200) {\n\n            bombReleased = true\n\n            bombingActive = true\n            bombingTime = 0\n            bombMessageTimer = 100\n\n            pilotState = 5\n            pilotTimer = 0\n        }\n    }\n\n    // STATE 5: PULL UP\n    else if (pilotState == 5) {\n\n        targetPitch = 22\n        targetRoll = 0\n        targetYaw = 0\n        targetSpeed = 230\n\n        if (pilotTimer > 2200) {\n            pilotState = 4\n            pilotTimer = 0\n        }\n    }\n\n    // STATE 4: RECOVERY\n    else if (pilotState == 4) {\n\n        targetRoll = 0\n        targetPitch = 0\n        targetYaw = 0\n        targetSpeed = cruiseSpeed\n\n        if (pilotTimer > 2500) {\n\n            pilotState = 0\n            pilotTimer = 0\n\n            nextManeuver = randint(15000, 30000)\n        }\n    }\n\n    // Smooth aircraft movement\n    aircraftRoll +=\n        (targetRoll - aircraftRoll) *\n        pilotResponsiveness\n\n    aircraftPitch +=\n        (targetPitch - aircraftPitch) *\n        pilotResponsiveness\n\n    aircraftYaw +=\n        (targetYaw - aircraftYaw) *\n        pilotResponsiveness\n\n    // Smooth speed changes\n    speed += (targetSpeed - speed) * 0.025\n\n    // Convert aircraft roll to horizon tilt\n    tilt = Math.tan(\n        aircraftRoll * Math.PI / 180\n    ) * 120\n}\nfunction getViewYaw(): number {\n    return cameraYaw + aircraftYaw\n}\n\nfunction getViewPitch(): number {\n    return cameraPitch - aircraftPitch\n}\nfunction updateBombingMission() {\n\n    if (bombMessageTimer > 0) {\n        bombMessageTimer -= 1\n    }\n\n    if (bombingActive) {\n\n        bombingTime += 1\n\n        // Carrier moves farther behind us\n        carrierZ += speed / 200 * 10\n\n        // Delayed explosion\n        if (bombingTime >= explosionDelay) {\n            explosionTime += 1\n        }\n\n        // Remove carrier once sufficiently distant\n        if (carrierZ > 12000) {\n            bombingActive = false\n        }\n    }\n}\n\nfunction projectMissionPoint(\n    worldX: number,\n    worldY: number,\n    worldZ: number\n): number[] {\n\n    let yaw = getViewYaw() * Math.PI / 180\n\n    let pitch = -Math.max(\n        -80, Math.min(80, getViewPitch())\n    ) * Math.PI / 180\n\n    let rx =\n        worldX * Math.cos(yaw) -\n        worldZ * Math.sin(yaw)\n\n    let rz =\n        worldX * Math.sin(yaw) +\n        worldZ * Math.cos(yaw)\n\n    let ry =\n        worldY * Math.cos(pitch) -\n        rz * Math.sin(pitch)\n\n    let pointDepth =\n        worldY * Math.sin(pitch) +\n        rz * Math.cos(pitch)\n\n    if (pointDepth <= 100) {\n        return []\n    }\n\n    let sx = 120 + rx * focalLength / pointDepth\n    let sy = 90 + ry * focalLength / pointDepth\n\n    sy += tilt * (sx - 120) / 120\n\n    return [sx, sy, pointDepth]\n}\n\nfunction renderCarrier() {\n\n    if (!bombingActive || carrierZ <= 0) {\n        return\n    }\n\n    let point = projectMissionPoint(\n        carrierX, carrierY, carrierZ\n    )\n\n    if (point.length == 0) {\n        return\n    }\n\n    let sx = point[0]\n    let sy = point[1]\n\n    let s = Math.min(\n        2, 900 / point[2]\n    )\n\n    // SHIP HULL\n    fillQuad(\n        sx - 48 * s, sy,\n        sx + 48 * s, sy,\n        sx + 38 * s, sy + 9 * s,\n        sx - 38 * s, sy + 9 * s,\n        3\n    )\n\n    // FLIGHT DECK\n    fillQuad(\n        sx - 52 * s, sy,\n        sx - 39 * s, sy - 10 * s,\n        sx + 39 * s, sy - 10 * s,\n        sx + 52 * s, sy,\n        11\n    )\n\n    // DECK EDGE\n    terrain.drawLine(\n        Math.round(sx - 52 * s),\n        Math.round(sy),\n        Math.round(sx + 52 * s),\n        Math.round(sy),\n        10\n    )\n\n    // FLIGHT DECK MARKINGS\n    for (let mark = -4; mark <= 4; mark++) {\n\n        terrain.drawLine(\n            Math.round(sx + mark * 9 * s),\n            Math.round(sy - 5 * s),\n            Math.round(sx + (mark * 9 + 5) * s),\n            Math.round(sy - 5 * s),\n            1\n        )\n    }\n\n    // JAPANESE DECK MARKING\n    \n\n    // ISLAND SUPERSTRUCTURE\n    fillQuad(\n        sx + 20 * s, sy - 7 * s,\n        sx + 20 * s, sy - 21 * s,\n        sx + 31 * s, sy - 21 * s,\n        sx + 31 * s, sy - 7 * s,\n        6\n    )\n\n    // ANTENNA\n    terrain.drawLine(\n        Math.round(sx + 26 * s),\n        Math.round(sy - 21 * s),\n        Math.round(sx + 26 * s),\n        Math.round(sy - 28 * s),\n        3\n    )\n}\n\nfunction renderCarrierExplosion() {\n\n    if (!bombingActive || explosionTime <= 0) {\n        return\n    }\n\n    // RISING SMOKE COLUMN\n\n    // RISING SMOKE COLUMN\n    for (let smokeIndex = 39; smokeIndex >= 0; smokeIndex--) {\n\n        // Continuous upward movement\n        let smokeAge =\n            (explosionTime - smokeIndex * 4) % 160\n\n        if (smokeAge > 0) {\n\n            let rise = smokeAge * 5\n\n            // Wind and turbulent movement\n            let drift = rise * 0.18\n\n            let turbulence = Math.sin(\n                smokeAge * 0.09\n            ) * (8 + rise * 0.06)\n\n            let smokeX = carrierX +\n                drift + turbulence\n\n            let smokeY = carrierY - 25 - rise\n\n            let smokePoint = projectMissionPoint(\n                smokeX,\n                smokeY,\n                carrierZ\n            )\n\n            if (smokePoint.length > 0) {\n\n                let sx = Math.round(smokePoint[0])\n                let sy = Math.round(smokePoint[1])\n\n                let smokeScale =\n                    focalLength / smokePoint[2]\n\n                // Smoke expands as it rises\n                let smokeRadius = Math.max(\n                    1,\n                    Math.min(\n                        22,\n                        (12 + rise * 0.09) * smokeScale\n                    )\n                )\n\n                // Smoke becomes lighter at higher altitude\n                let smokeColor = 3\n\n                if (smokeAge > 50) {\n                    smokeColor = 10\n                }\n\n                if (smokeAge > 110) {\n                    smokeColor = 12\n                }\n\n                // Irregular central smoke puff\n                terrain.fillCircle(\n                    sx, sy,\n                    Math.max(1, Math.round(smokeRadius)),\n                    smokeColor\n                )\n\n                // Smaller left-side puff\n                terrain.fillCircle(\n                    Math.round(sx - smokeRadius * 0.7),\n                    Math.round(sy - smokeRadius * 0.4),\n                    Math.max(1, Math.round(smokeRadius * 0.65)),\n                    smokeColor\n                )\n\n                // Smaller right-side puff\n                terrain.fillCircle(\n                    Math.round(sx + smokeRadius * 0.6),\n                    Math.round(sy + smokeRadius * 0.3),\n                    Math.max(1, Math.round(smokeRadius * 0.55)),\n                    smokeColor\n                )\n            }\n        }\n    }\n\n\n    // EXPLOSION POSITION\n    let firePoint = projectMissionPoint(\n        carrierX,\n        carrierY - 30,\n        carrierZ\n    )\n\n    if (firePoint.length == 0) {\n        return\n    }\n\n    let fx = Math.round(firePoint[0])\n    let fy = Math.round(firePoint[1])\n\n    let fireScale =\n        focalLength / firePoint[2]\n\n\n    // ========================================\n    // SMOOTH EXPLOSION TRANSITION\n    // ========================================\n\n    // Fireball contraction progress\n    let contraction = Math.max(\n        0, Math.min(1, (explosionTime - 10) / 65)\n    )\n\n    // Flame growth progress\n    let flameGrowth = Math.max(\n        0, Math.min(1, (explosionTime - 25) / 50)\n    )\n\n    // CONTINUOUS FLAMES\n    // Gradually grow underneath the fireball\n    if (flameGrowth > 0) {\n\n        for (let flame = 0; flame < 5; flame++) {\n\n            let flameX =\n                fx + (flame - 2) * 20 * fireScale\n\n            // Smooth flame animation\n            let flicker = 65 + Math.sin(\n                explosionTime * 0.3 + flame * 2\n            ) * 25\n\n            let flameHeight =\n                flicker * fireScale * flameGrowth\n\n            let flameWidth =\n                15 * fireScale * flameGrowth\n\n            // Orange outer flame\n            fillTriangle(\n                flameX - flameWidth, fy,\n                flameX + flameWidth, fy,\n                flameX, fy - flameHeight,\n                4\n            )\n\n            // Yellow inner flame\n            fillTriangle(\n                flameX - flameWidth / 2, fy,\n                flameX + flameWidth / 2, fy,\n                flameX, fy - flameHeight * 0.65,\n                5\n            )\n        }\n    }\n\n    // CONTRACTING FIREBALL\n    if (contraction < 1) {\n\n        // Smooth contraction curve\n        let remaining = 1 - contraction\n\n        let fireSize =\n            240 * remaining * remaining\n\n        let radius = Math.min(\n            65, Math.round(fireSize * fireScale)\n        )\n\n        // Fireball settles toward the flight deck\n        let fireballY = Math.round(\n            fy - 25 * fireScale * remaining\n        )\n\n        if (radius >= 1) {\n\n            // Orange outer fireball\n            terrain.fillCircle(\n                fx, fireballY, radius, 4\n            )\n\n            // Yellow inner fireball\n            terrain.fillCircle(\n                fx, fireballY,\n                Math.max(1, Math.round(radius * 0.65)),\n                5\n            )\n\n            // White-hot core gradually contracts\n            if (explosionTime < 20) {\n\n                let whiteRadius = Math.round(\n                    radius * 0.4 *\n                    (1 - explosionTime / 20)\n                )\n\n                if (whiteRadius >= 1) {\n                    terrain.fillCircle(\n                        fx, fireballY, whiteRadius, 1\n                    )\n                }\n            }\n        }\n    }\n}\n\n\nfunction renderBombMessage() {\n\n    if (bombMessageTimer > 0) {\n\n        terrain.fillRect(\n            65, 33, 110, 14, 3\n        )\n\n        terrain.print(\n            \"BOMB RELEASED\",\n            81, 36, 5\n        )\n    }\n}"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":251,"length1":80,"diffs":[[1,"    \"preferredEditor\": \"tsprj\",\n"]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"}]}],"snapshots":[{"timestamp":1795645764376,"editorVersion":"4.1.32","text":{"main.blocks":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>","main.ts":" ","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"rear gunner prototype\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.blocks\",\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1795647571081,"editorVersion":"4.1.32","text":{"main.blocks":"<xml xmlns=\"https://developers.google.com/blockly/xml\"><vari